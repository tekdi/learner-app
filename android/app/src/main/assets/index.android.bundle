2c\u0b33\u0b40 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b47 \u0b38\u0b3e\u0b39\u0b3e\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b3f\u0b2c\u0964",I_am_18_or_older:"\u0b2e\u0b41\u0b01 \u0b67\u0b6e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b24\u0b3e\u2019\u0b20\u0b3e\u0b30\u0b41 \u0b05\u0b27\u0b3f\u0b15 \u0b2c\u0b5f\u0b38\u0b4d\u0b15",I_am_under_18:"\u0b2e\u0b41\u0b01 \u0b67\u0b6e \u0b2c\u0b30\u0b4d\u0b37\u0b30\u0b41 \u0b15\u0b2e\u0b4d","T&C":"\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b17\u0b4b\u0b2a\u0b28\u0b40\u0b5f\u0b24\u0b3e \u0b28\u0b40\u0b24\u0b3f\u0b15\u0b41 \u0b36\u0b47\u0b37 \u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b4b\u0b32 \u0b15\u0b30\u0b3f \u0b2a\u0b22\u0b3c\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b3e\u0b39\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e",create_account:"\u0b16\u0b3e\u0b24\u0b3e \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41",button:"\u0b2c\u0b1f\u0b28","T&C_1":"\u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b0f\u0b1c\u0b41\u0b15\u0b47\u0b38\u0b28\u0b4d \u0b2b\u0b3e\u0b09\u0b23\u0b4d\u0b21\u0b47\u0b38\u0b28\u0b4d (\u0b2a\u0b4d\u0b30\u0b25\u0b2e) \u0b39\u0b47\u0b09\u0b1b\u0b3f \u0b2d\u0b3e\u0b30\u0b24\u0b30 \u0b05\u0b28\u0b4d\u0b5f\u0b24\u0b2e \u0b2c\u0b43\u0b39\u0b24\u0b4d\u0b24\u0b2e \u0b0f\u0b28\u0b1c\u0b3f\u0b13, \u0b2f\u0b3e\u0b39\u0b3e\u0b30 \u0b30\u0b47\u0b1c\u0b3f\u0b37\u0b4d\u0b1f\u0b30\u0b4d\u0b21 \u0b05\u0b2b\u0b3f\u0b38\u0b4d \u0b2e\u0b41\u0b2e\u0b4d\u0b2c\u0b3e\u0b07\u0b30\u0b47 \u0b05\u0b1b\u0b3f\u0964 \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b68\u0b6b \u0b2c\u0b30\u0b4d\u0b37\u0b30\u0b41 \u0b05\u0b27\u0b3f\u0b15 \u0b38\u0b2e\u0b5f \u0b27\u0b30\u0b3f \u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b4d\u0b37\u0b47\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b41\u0b1b\u0b3f\u0964","T&C_2":"\u0b06\u0b2a\u0b23 \u0b1c\u0b3e\u0b23\u0b3f\u0b1b\u0b28\u0b4d\u0b24\u0b3f \u0b2f\u0b47, \u0b06\u0b2a\u0b23 \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b4d\u0b30\u0b2e\u0b30\u0b47 \u0b05\u0b02\u0b36\u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b41\u0b1b\u0b28\u0b4d\u0b24\u0b3f\u0964 \u0b0f\u0b39\u0b3f \u0b38\u0b28\u0b4d\u0b26\u0b30\u0b4d\u0b2d\u0b30\u0b47, \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b24\u0b3e\u2019\u0b30 \u0b38\u0b4d\u0b71\u0b47\u0b1a\u0b4d\u0b1b\u0b3e\u0b38\u0b47\u0b2c\u0b40/\u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b28\u0b3f\u0b27\u0b3f\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b24\u0b25\u0b4d\u0b5f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b3f\u0b2c, \u0b2f\u0b3e\u0b39\u0b3e\u0b30\u0b47 \u0b2e\u0b42\u0b33 \u0b2a\u0b30\u0b3f\u0b1a\u0b5f, \u0b05\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b28, \u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b38\u0b42\u0b1a\u0b28\u0b3e, \u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b23 \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b40\u0b5f \u0b24\u0b25\u0b4d\u0b5f, \u0b1a\u0b3f\u0b24\u0b4d\u0b30/\u0b2b\u0b1f\u0b4b, \u0b2d\u0b3f\u0b21\u0b3f\u0b13, \u0b38\u0b4d\u0b71\u0b30 \u0b30\u0b47\u0b15\u0b30\u0b4d\u0b21\u0b3f\u0b02 (\u2018\u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38\u2019) \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b2d\u0b41\u0b15\u0b4d\u0b24 \u0b39\u0b47\u0b2c\u0964","T&C_3":"\u0b38\u0b02\u0b17\u0b43\u0b39\u0b40\u0b24 \u0b24\u0b25\u0b4d\u0b5f/\u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b09\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b4d\u0b5f\u0b30\u0b47 \u0b06\u0b02\u0b36\u0b3f\u0b15 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b2d\u0b3e\u0b2c\u0b47 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b39\u0b47\u0b2c:","T&C_4":"\u0b67. \u0b2a\u0b4d\u0b30\u0b4b\u0b17\u0b4d\u0b30\u0b3e\u0b2e \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b3e\u0b30\u0b40 \u0b0f\u0b2c\u0b02 \u0b09\u0b28\u0b4d\u0b28\u0b24\u0b3f, \u0b38\u0b2e\u0b41\u0b26\u0b3e\u0b5f \u0b38\u0b02\u0b2f\u0b4b\u0b17, \u0b0f\u0b2c\u0b02 \u0b30\u0b3f\u0b2a\u0b4b\u0b30\u0b4d\u0b1f\u0b3f\u0b02 \u0b09\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b4d\u0b5f\u0964","T&C_5":"\u0b68. \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b30 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b36\u0b28, \u0b26\u0b3e\u0b24\u0b3e \u0b30\u0b3f\u0b2a\u0b4b\u0b30\u0b4d\u0b1f (\u0b2d\u0b3e\u0b30\u0b24 \u0b24\u0b25\u0b3e \u0b06\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b1c\u0b3e\u0b24\u0b40\u0b5f), \u0b2e\u0b3f\u0b21\u0b3f\u0b06 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a, \u0b38\u0b4b\u0b38\u0b3f\u0b06\u0b32 \u0b2e\u0b3f\u0b21\u0b3f\u0b06 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a (\u0b2f\u0b25\u0b3e: \u0b2b\u0b47\u0b38\u0b2c\u0b41\u0b15, \u0b5f\u0b41\u0b1f\u0b4d\u0b5f\u0b41\u0b2c, \u0b07\u0b28\u0b37\u0b4d\u0b1f\u0b3e\u0b17\u0b4d\u0b30\u0b3e\u0b2e, \u0b32\u0b3f\u0b19\u0b4d\u0b15\u0b21\u0b3c\u0b3f\u0b28, \u0b1f\u0b4d\u0b71\u0b3f\u0b1f\u0b30, \u0b25\u0b4d\u0b30\u0b47\u0b21\u0b3c\u0b38 \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f), \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32 \u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e\u0b30\u0b47 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a (\u0b2f\u0b25\u0b3e: \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b30 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f)\u0964 \u0b0f\u0b39\u0b3e \u0b36\u0b3f\u0b15\u0b4d\u0b37\u0b3e\u0b17\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b15\u0b33\u0b3e\u0b2a \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 \u0b38\u0b1a\u0b47\u0b24\u0b28\u0b24\u0b3e \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b43\u0b24 \u0b39\u0b47\u0b2c\u0964","T&C_6":"\u0b69. \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b30 \u0b26\u0b3e\u0b28\u0b36\u0b40\u0b33 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b2c\u0b3f\u0b37\u0b5f\u0b30\u0b47 \u0b38\u0b1a\u0b47\u0b24\u0b28\u0b24\u0b3e \u0b38\u0b43\u0b37\u0b4d\u0b1f\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b26\u0b3e\u0b24\u0b3e\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b38\u0b39 (\u0b2d\u0b3e\u0b30\u0b24 \u0b24\u0b25\u0b3e \u0b06\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b1c\u0b3e\u0b24\u0b40\u0b5f) \u0b05\u0b02\u0b36\u0b40\u0b26\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0964","T&C_7":"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b24\u0b25\u0b4d\u0b5f/\u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39, \u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b23 \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b26\u0b47\u0b2c\u0b3e\u0b15\u0b41 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f\u0964 \u0b24\u0b25\u0b3e\u0b2a\u0b3f, \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2c\u0b3f\u0b2c\u0b47\u0b1a\u0b28\u0b3e \u0b05\u0b28\u0b41\u0b2f\u0b3e\u0b5f\u0b40, \u0b06\u0b2a\u0b23 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b24\u0b25\u0b4d\u0b5f/\u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b05\u0b38\u0b4d\u0b71\u0b40\u0b15\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964","T&C_8":"\u0b2e\u0b41\u0b01 \u0b2a\u0b4d\u0b30\u0b25\u0b2e, \u0b24\u0b3e\u2019\u0b30 \u0b38\u0b4d\u0b71\u0b47\u0b1a\u0b4d\u0b1b\u0b3e\u0b38\u0b47\u0b2c\u0b40 \u0b0f\u0b2c\u0b02/\u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b28\u0b3f\u0b27\u0b3f\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30, \u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b23, \u0b05\u0b02\u0b36\u0b40\u0b26\u0b3e\u0b30, \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b36\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2c\u0b3f\u0b28\u0b3e \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b2c\u0b3e\u0b27\u0b4d\u0b5f\u0b2c\u0b3e\u0b27\u0b15\u0b24\u0b3e\u0b30\u0b47 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b26\u0b47\u0b09\u0b1b\u0b3f\u0964","T&C_9":"\u0b2f\u0b26\u0b3f \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b2e\u0b41\u0b01 \u0b28\u0b3f\u0b37\u0b4d\u0b2a\u0b24\u0b4d\u0b24\u0b3f \u0b28\u0b47\u0b09\u0b1b\u0b3f \u0b2f\u0b47 \u0b2e\u0b4b \u0b24\u0b25\u0b4d\u0b5f/\u0b2b\u0b1f\u0b4b/\u0b2d\u0b3f\u0b21\u0b3f\u0b13 \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b30 \u0b71\u0b47\u0b2c\u0b38\u0b3e\u0b07\u0b1f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b37\u0b4d\u0b1f\u0b4b\u0b30\u0b47\u0b1c\u0b4d \u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e\u0b30\u0b41 \u0b39\u0b1f\u0b3e\u0b2f\u0b3e\u0b09, \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09, \u0b2e\u0b41\u0b01 \u0b2b\u0b4b\u0b28/\u0b07\u0b2e\u0b47\u0b32 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0b30 \u0b38\u0b4d\u0b71\u0b47\u0b1a\u0b4d\u0b1b\u0b3e\u0b38\u0b47\u0b2c\u0b40/\u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b28\u0b3f\u0b27\u0b3f\u0b19\u0b4d\u0b15\u0b41 \u0b1c\u0b23\u0b3e\u0b07\u0b2c\u0b3f, \u0b2f\u0b3e\u0b39\u0b3e \u0b2a\u0b30\u0b47 \u0b32\u0b3f\u0b16\u0b3f\u0b24 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b3e\u0b39\u0b3e\u0b30/\u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964 \u0b24\u0b3e\u2019\u0b2a\u0b30\u0b47, \u0b2a\u0b4d\u0b30\u0b25\u0b2e, \u0b24\u0b3e\u2019\u0b30 \u0b38\u0b4d\u0b71\u0b47\u0b1a\u0b4d\u0b1b\u0b3e\u0b38\u0b47\u0b2c\u0b40 \u0b0f\u0b2c\u0b02/\u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b24\u0b3f\u0b28\u0b3f\u0b27\u0b3f\u0b2e\u0b3e\u0b28\u0b47 \u0b67\u0b6b \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b26\u0b3f\u0b2c\u0b38 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b24\u0b3e\u0b39\u0b3e \u0b39\u0b1f\u0b3e\u0b07\u0b2c\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28/\u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b15\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b0f\u0b39\u0b3f \u0b38\u0b28\u0b4d\u0b26\u0b30\u0b4d\u0b2d\u0b30\u0b47, \u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b28\u0b3f\u0b2e\u0b4d\u0b28\u0b30\u0b47 \u0b26\u0b3f\u0b06\u0b2f\u0b3e\u0b07\u0b1b\u0b3f\u0964","T&C_10":"\u0b2e\u0b41\u0b01 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2c\u0b3f\u0b37\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b2a\u0b22\u0b3c\u0b3f\u0b1b\u0b3f \u0b0f\u0b2c\u0b02/\u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b2d\u0b3e\u0b37\u0b3e\u0b30\u0b47 \u0b2c\u0b41\u0b1d\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f \u0b0f\u0b2c\u0b02 \u0b0f\u0b39\u0b3e\u0b30 \u0b28\u0b40\u0b24\u0b3f\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23\u0b30\u0b42\u0b2a\u0b47 \u0b2c\u0b41\u0b1d\u0b3f\u0b1b\u0b3f\u0964 \u0b2e\u0b41\u0b01 \u0b0f\u0b39\u0b3e\u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2e\u0b4b \u0b2e\u0b47\u0b1f\u0b47\u0b30\u0b3f\u0b06\u0b32\u0b4d\u0b38/\u0b24\u0b25\u0b4d\u0b5f\u0b30 \u0b09\u0b2a\u0b30\u0b4b\u0b15\u0b4d\u0b24 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b41\u0b1b\u0b3f \u0b0f\u0b2c\u0b02 \u0b0f\u0b39\u0b3f \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b38\u0b2e\u0b4d\u0b2c\u0b28\u0b4d\u0b27\u0b30\u0b47 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b26\u0b3e\u0b2c\u0b3f \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b3f \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964","T&C_11":"\u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40: \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b0f\u0b1c\u0b41\u0b15\u0b47\u0b38\u0b28\u0b4d \u0b2b\u0b3e\u0b09\u0b23\u0b4d\u0b21\u0b47\u0b38\u0b28\u0b4d",office_adrress:"\u0b26\u0b3f\u0b32\u0b4d\u0b32\u0b40 \u0b05\u0b2b\u0b3f\u0b38\u0b4d: \u0b2c\u0b3f\u0b6a/\u0b6b\u0b6f, \u0b38\u0b2b\u0b26\u0b30\u0b1c\u0b19\u0b4d\u0b17 \u0b0f\u0b28\u0b15\u0b4d\u0b32\u0b47\u0b2d, \u0b28\u0b42\u0b06 \u0b26\u0b3f\u0b32\u0b4d\u0b32\u0b40-\u0b67\u0b67\u0b66\u0b66\u0b68\u0b6f",office_email:"\u0b07\u0b2e\u0b47\u0b32: dataprotectionofficer@pratham.org",office_phone:"\u0b2b\u0b4b\u0b28 \u0b28\u0b2e\u0b4d\u0b2c\u0b30: \u0b66\u0b67\u0b67-\u0b68\u0b6c\u0b67\u0b6d\u0b6d\u0b68\u0b66\u0b66",office_website:"| www.pratham.org |",office_cin:"\u0b38\u0b3f\u0b06\u0b07\u0b0f\u0b28: U80101MH2002NPL136300","T&C_12":"\u0b2e\u0b41\u0b01 \u0b17\u0b4b\u0b2a\u0b28\u0b40\u0b5f\u0b24\u0b3e \u0b28\u0b40\u0b24\u0b3f \u0b2a\u0b22\u0b3c\u0b3f\u0b1b\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b2e\u0b4d\u0b2e\u0b24 \u0b39\u0b4b\u0b07\u0b1b\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b2b\u0b30\u0b4d\u0b2e\u0b30\u0b47 \u0b2c\u0b30\u0b4d\u0b23\u0b4d\u0b23\u0b3f\u0b24 \u0b2e\u0b4b \u0b2c\u0b4d\u0b5f\u0b15\u0b4d\u0b24\u0b3f\u0b17\u0b24 \u0b24\u0b25\u0b4d\u0b5f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b0f\u0b2c\u0b02 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b2e\u0b4d\u0b2e\u0b24\u0b3f \u0b26\u0b47\u0b09\u0b1b\u0b3f\u0964","T&C_13":"\u0b06\u0b2a\u0b23 \u0b2a\u0b4d\u0b30\u0b4b\u0b2b\u0b3e\u0b07\u0b32 \u0b2a\u0b43\u0b37\u0b4d\u0b20\u0b3e\u0b30\u0b47 \u2018\u0b21\u0b3e\u0b1f\u0b3e \u0b0f\u0b2c\u0b02 \u0b17\u0b4b\u0b2a\u0b28\u0b40\u0b5f\u0b24\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u2019\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40\u0b30\u0b41 \u0b2f\u0b47\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b21\u0b3e\u0b1f\u0b3e \u0b2c\u0b3f\u0b32\u0b4b\u0b2a, \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d, \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b30\u0b3f\u