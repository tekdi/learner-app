__d(function(e,o,a,t,n,s,r){n.exports={welcome:"Welcome",choose_language:"Start by selecting a language of App",select_language:"Choose the language for menus and navigation",english:"English",hindi:"\u0939\u093f\u0902\u0926\u0940",marathi:"\u092e\u0930\u093e\u0920\u0940",odia:"\u0b13\u0b21\u0b3c\u0b3f\u0b06",bengali:"\u09ac\u09be\u0982\u09b2\u09be",bangla:"\u09ac\u09be\u0982\u09b2\u09be",telugu:"\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41",kannada:"\u0c95\u0ca8\u0ccd\u0ca8\u0ca1",tamil:"\u0ba4\u0bae\u0bbf\u0bb4\u0bcd",gujarati:"\u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0",urdu:"\u0627\u064f\u0631\u062f\u064f\u0648",language_help:"You can change the language any time later",continue:"Continue",back:"Back",finish:"Finish",let_log_in:"Okay, let's get you logged in!",i_am_new_user:"I am a new user",already_login:"I already have my login credentials",form_start_lable:"Just a few quick questions before we start your learning journey",first_name:"First Name",last_name:"Last Name",age_group:"What is your age and gender?",q2_op_1:"3 - 6 years",q2_op_2:"6 - 10 years",q2_op_3:"10 - 14 years",q2_op_4:"14 and above",gender:"Gender",female:"Female",male:"Male",q4_language:"Preferred language of learning?",q5_interested_in:"What type of content are your interested in?",interested_content:"What type of content are your interested in?",q5_interested_in_info:"Choose at least 3",INCLUSIVE_EDUCATION:"Inclusive Education",HEALTH:"Health",ART:"Art",MUSIC:"Music",FINANCIAL_LITERACY:"Financial Literacy",CONCEPTUAL_THINKING:"Conceptual Thinking",ENVIRONMENT:"Environment",CAREER_AWARENESS:"Career Awareness",FUN:"Fun",EFFECTIVE_COMMUNICATION:"Effective Communication",q6_login_cred:"Lastly, let's create your login credentials",lb_username:"Customize Your Username",lb_username_info:"This will be used during login",lb_username_error:"A user with that name already exists",lb_pass:"Password",confirm_password:"Confirm Password",customize_dashboard_message:"Customizing your dashboard for you..",login:"Login",content:"Content",courses:"Courses",profile:"Profile",usersname:"Customize Your Username",username:"Username",password:"Password",forgot_password:"Forgot Password",remember_me:"Remember Me",is_required:"is required",min:"minimum",max:"maximum",characters:"characters",Password_must_match:"Password must match",can_only_contain_letters:"can only contain letters",Choose_at_least:"Choose at least",cards_can_be_selected:"cards can be selected",terms_and_conditions:"Lastly, To ensure a safe and tailored experience, please let us know your age. Your response will help us provide the appropriate terms and conditions.",I_am_18_or_older:"I am 18 or older",I_am_under_18:"I am under 18","T&C":"Please read the following Privacy Policy by scrolling all the way to the bottom to enable the",create_account:"Create Account",button:"button","T&C_1":"Pratham Education Foundation (Pratham) is one of India's largest NGOs, with its registered office in Mumbai Pratham has worked in the field of education for more than 25 years.","T&C_2":"As you are aware, you are participating in the activities conducted by Pratham. In reference to this, Pratham, through its volunteers/representatives, shall collect your data which includes but is not limited to basic identification, location, contact information, learning related data, images/photographs, videos, voice recordings (the 'Materials'), while participating in the activities.","T&C_3":"The collected information/materials shall be used in part or in whole for the following purposes:","T&C_4":"1. Program implementation & improvement, community engagement, and reporting purposes.","T&C_5":"2. In Pratham's publications, donor reports (in India as well as internationally), media activities, social media activities (e.g.: Facebook, YouTube, Instagram, LinkedIn, Twitter, Threads, etc.), activities on digital platforms (e.g.: Pratham's websites). The same shall be used for creating awareness about educational activities.","T&C_6":"3. To share with donors (in India as well as internationally) in order to create awareness about Pratham's charitable work.","T&C_7":"You are requested to give your consent to collect, store and use the above-mentioned information/materials. However, as per your discretion, you can deny your consent for collecting your information/materials.","T&C_8":"I grant consent to Pratham, its volunteers and/or representatives to use, store, share, publish the above-mentioned materials related to me without any coercion.","T&C_9":"If at any point in time I decide that my data/photo/video should be removed, updated or rectified from Pratham's website or storage platforms, I shall inform Pratham's volunteer/representative via phone/email, which can be followed up by a written withdrawal/updation of consent. Thereafter, Pratham, its volunteers and/or representatives shall remove or rectify/update the same within 15 working days. In this regard, the contact details have been given below.","T&C_10":"I have read and/or been explained in vernacular the foregoing and fully understand the contents of the terms hereof. I hereby confirm my consent for the above-mentioned terms of use of my materials/information and will not raise any claim whatsoever in regard to such usage.","T&C_11":"Contact Details: Pratham Education Foundation",office_adrress:"Delhi Office: B4/59, Safdarjung Enclave, New Delhi-110029",office_email:"Email:dataprotectionofficer@pratham.org",office_phone:"Phone no: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"I have read and agree to the Privacy Policy and I consent to the collection and use of my personal data as described in the Consent Form.","T&C_13":"You can request for data deletion, updating, or changes any time from the contact details provided in 'Data & Privacy Center' in the profile page.",username_already_exists:"Username already exists",username_is_already_exists_in_keycloak:"Username already exists",something_went_wrong_try_again_later:"Something went wrong, please try again later.",Learning_Content:"Learning Content",Update_your_preferences_to_get_the_best_picks_just_for_you:"Update your preferences to get the best picks just for you!",Based_on_Your_Interests:"Based on Your Interests",view_all:"View All",Financial_Literacy:"Financial Literacy",Continue_Learning:"Continue Learning",Preferences:"Preferences",Food_Production:"Food Production",Conceptual_Thinking:"Conceptual Thinking",Todays_Top_Pick:"Today's Top Pick",Art:"Art",Assessments:"Assessments",assessment:"Assessment","pre-test":"Pre Test","post-test":"Post Test",Inprogress:"In Progress",Overallscore:"Overall Score:",completed:"Completed",take_the_test:"Start the Test",not_started:"Not Started",submitted_On:"Submitted On :",reading:"READING",out_of:"out of",correct_answers:"correct Answers",assessment_note:"Note: Your Pre-test will be considered only if you complete all the subjects.",assessment_instructions:"Complete the tests for each of the subjects below. Feel free to do them in any order.",instruction1:"Duration: The test is timed and will last for 20 minutes. Please manage your time accordingly.",instruction2:"Number of Questions: The test comprises multiple-choice questions. Ensure you answer all questions within the given time frame.",instruction3:"Submission: You can only submit the test once. Make sure you review your answers carefully before submitting, as you will not have another opportunity to submit.",instruction4:"Starting the Test: Ensure you are in a quiet environment with no interruptions. Make sure your internet connection is stable.",instruction5:"Navigating the Test: Read each question carefully before selecting your answer. You may skip questions and return to them later if needed, but keep an eye on the timer. Use the Next and Previous buttons to navigate between questions.","Read_T_&_C":"I have read and agree to the",terms_and_conditions2:"Terms & Conditions",no_data_found:"No Data Found",my_profile:"My Profile",second_chance_program:"Second Chance Program",logout:"Log Out",general_instructions:"General Instructions",test_medium:"Test Medium",board:"Board",start_test:"Start Test",block:"Block",unit:"Unit",enrollment_number:"Enrollment Number",contact_number:"Contact Number",class:"Class",last_passed_grade:"Last Passed Grade",age:"Age",en:"EN",hi:"\u0939\u093f\u0902",ma:"\u092e",ba:"\u09ac\u09be",te:"\u0c24\u0c46.",ka:"\u0c95\u0cbe.",ta:"\u0ba4",gu:"\u0a97\u0ac1",ur:"\u0627\u064f\u0631\u062f\u064f\u0648",invalid_username_or_password:"Invalid Username or Password",network_error_try_again_later:"Network error try again later",log_in:"Log In",login_with_the_cred:"Log in with the credentials provided to you",total_marks:"Total Marks",full_name:"Full Name",state:"State",district:"District",unanswered:"Unanswered",no_internet_connection:"Oops, No Internet Connection",make_sure_wifi_or_mobile_data_is_turned_on_and_try_again:"Make sure wifi or mobile data is turned on, and try again.",try_again:"Try again",are_you_sure_you_want_to_exit_the_app:"Are you sure you want to exit the app?",are_you_sure_you_want_to_logout_the_app:"Are you sure you want to logout?",yes:"Yes",no:"No",course_details:"Course Details",sync_pending_no_internet_available:"Sync pending. No internet available",back_online_syncing:"Back online! Syncing",test_completed:"Test Completed!",your_marks:"Your Marks:",your_test_will_be_auto_saved_once_you_are_back_online:"Your test will be auto-saved once you are back online",okay:"Okay",downloaded_for_offline_access:"Downloaded for offline access",unsupported_content:"Unsupported Content",content_not_in_device:"The content isn't downloaded for offline playback. Please connect to the internet to play.",enable:"Enable",not_now:"Not now",enable_location_to_discover_nearby_skilling_centers_and_more_opportunities_tailored_just_for_you:"Enable location to discover nearby skilling centers and more opportunities tailored just for you!",which_program_do_you_want_to_en