u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41\u0c28\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2e\u0c40 \u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28 \u0c2e\u0c3e\u0c15\u0c41 \u0c38\u0c30\u0c48\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c37\u0c30\u0c24\u0c41\u0c32\u0c28\u0c41 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",I_am_18_or_older:"\u0c28\u0c47\u0c28\u0c41 18 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c02\u0c24\u0c15\u0c02\u0c1f\u0c47 \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c35\u0c2f\u0c38\u0c4d\u0c38\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41",I_am_under_18:"\u0c28\u0c47\u0c28\u0c41 18 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c32 \u0c15\u0c02\u0c1f\u0c47 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35","T&C":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c3f\u0c35\u0c30\u0c3f \u0c35\u0c30\u0c15\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c4b\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f, \u0c24\u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41",create_account:"\u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c41",button:"\u0c2c\u0c1f\u0c28\u0c4d","T&C_1":"\u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c0e\u0c21\u0c4d\u0c2f\u0c41\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2b\u0c4c\u0c02\u0c21\u0c47\u0c37\u0c28\u0c4d (\u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d) \u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c05\u0c24\u0c3f\u0c2a\u0c46\u0c26\u0c4d\u0c26 \u0c0e\u0c28\u0c4d\u0c1c\u0c40\u0c35\u0c4b\u0c32\u0c32\u0c4b \u0c12\u0c15\u0c1f\u0c3f, \u0c26\u0c40\u0c28\u0c3f \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c02 \u0c2e\u0c41\u0c02\u0c2c\u0c48\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d 25 \u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c32\u0c15\u0c41 \u0c2a\u0c48\u0c17\u0c3e \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e \u0c30\u0c02\u0c17\u0c02\u0c32\u0c4b \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c3f\u0c02\u0c26\u0c3f.","T&C_2":"\u0c2e\u0c40\u0c15\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c41\u0c17\u0c3e, \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c47 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c3e\u0c32\u0c4d\u0c17\u0c4a\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c41. \u0c08 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b, \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c24\u0c28 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41/\u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40 \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c07\u0c02\u0c26\u0c41\u0c32\u0c4b \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b \u0c2a\u0c3e\u0c32\u0c4d\u0c17\u0c4a\u0c28\u0c47\u0c1f\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2e\u0c42\u0c32 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41, \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02, \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02, \u0c05\u0c2d\u0c4d\u0c2f\u0c3e\u0c38 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c21\u0c47\u0c1f\u0c3e, \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41/\u0c2b\u0c4b\u0c1f\u0c4b\u0c32\u0c41, \u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b\u0c32\u0c41, \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41 ('\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d') \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f, \u0c15\u0c3e\u0c28\u0c40 \u0c07\u0c35\u0c3f \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c07\u0c24\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c42\u0c21\u0c3e \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","T&C_3":"\u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c3e\u0c15\u0c4d\u0c37\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f:","T&C_4":"1. \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c4d\u0c30\u0c2e \u0c05\u0c2e\u0c32\u0c41 & \u0c2e\u0c46\u0c30\u0c41\u0c17\u0c41\u0c26\u0c32, \u0c38\u0c02\u0c18\u0c02 \u0c28\u0c3f\u0c36\u0c4d\u0c1a\u0c3f\u0c24\u0c3e\u0c30\u0c4d\u0c25\u0c02, \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3f\u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c2f\u0c4b\u0c1c\u0c28\u0c3e\u0c32\u0c41.","T&C_5":"2. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c23\u0c32\u0c32\u0c4b, \u0c26\u0c3e\u0c24\u0c32 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c32\u0c4b (\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c1c\u0c3e\u0c24\u0c40\u0c2f\u0c02\u0c17\u0c3e), \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b, \u0c38\u0c4b\u0c37\u0c32\u0c4d \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c32\u0c4b (\u0c09\u0c26\u0c3e.: \u0c2b\u0c47\u0c38\u0c4d\u200c\u0c2c\u0c41\u0c15\u0c4d, \u0c2f\u0c42\u0c1f\u0c4d\u0c2f\u0c42\u0c2c\u0c4d, \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c17\u0c4d\u0c30\u0c3e\u0c2e\u0c4d, \u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c21\u0c4d\u0c07\u0c28\u0c4d, \u0c1f\u0c4d\u0c35\u0c3f\u0c1f\u0c4d\u0c1f\u0c30\u0c4d, \u0c25\u0c4d\u0c30\u0c46\u0c21\u0c4d\u0c38\u0c4d \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28\u0c35\u0c3f), \u0c21\u0c3f\u0c1c\u0c3f\u0c1f\u0c32\u0c4d \u0c2a\u0c4d\u0c32\u0c3e\u0c1f\u0c4d\u200c\u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c32\u0c4b \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32\u0c41 (\u0c09\u0c26\u0c3e.: \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d\u200c\u0c32\u0c41). \u0c07\u0c35\u0c3f \u0c35\u0c3f\u0c26\u0c4d\u0c2f\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c35\u0c17\u0c3e\u0c39\u0c28 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.","T&C_6":"3. \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c26\u0c3e\u0c24\u0c43\u0c24\u0c4d\u0c35 \u0c2a\u0c28\u0c3f \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c35\u0c17\u0c3e\u0c39\u0c28 \u0c15\u0c32\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c3e\u0c24\u0c32\u0c24\u0c4b (\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c24\u0c30\u0c4d\u0c1c\u0c3e\u0c24\u0c40\u0c2f\u0c02\u0c17\u0c3e) \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c02.","T&C_7":"\u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2e\u0c28\u0c3f \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c15\u0c4b\u0c30\u0c41\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c2e\u0c41. \u0c05\u0c2f\u0c3f\u0c24\u0c47, \u0c2e\u0c40 \u0c35\u0c3f\u0c1a\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02, \u0c2e\u0c40 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02/\u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c38\u0c47\u0c15\u0c30\u0c23\u0c15\u0c41 \u0c2e\u0c40 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","T&C_8":"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d, \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32\u0c15\u0c41 \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2c\u0c32\u0c35\u0c02\u0c24\u0c02 \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c28\u0c3e\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d\u200c\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2a\u0c4d\u0c30\u0c1a\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.","T&C_9":"\u0c0f \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b\u0c28\u0c48\u0c28\u0c3e \u0c28\u0c3e \u0c21\u0c47\u0c1f\u0c3e/\u0c2b\u0c4b\u0c1f\u0c4b/\u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b\u0c28\u0c41 \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c35\u0c46\u0c2c\u0c4d\u200c\u0c38\u0c48\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f, \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c3f \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c23\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c28\u0c47\u0c28\u0c41 \u0c2b\u0c4b\u0c28\u0c4d/\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c21\u0c41/\u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c3f\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c28\u0c41, \u0c26\u0c3e\u0c28\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c35\u0c4d\u0c30\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c35\u0c15 \u0c09\u0c2a\u0c38\u0c02\u0c39\u0c30\u0c23/\u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c1c\u0c30\u0c17\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c06 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d, \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c38\u0c47\u0c35\u0c15\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c28\u0c3f\u0c27\u0c41\u0c32\u0c41 15 \u0c2a\u0c28\u0c3f \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c32\u0c4b\u0c2a\u0c41 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c38\u0c35\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41/\u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41. \u0c08 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b, \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f.","T&C_10":"\u0c28\u0c47\u0c28\u0c41 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c1a\u0c26\u0c3f\u0c35\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41/\u0c32\u0c47\u0c26\u0c3e \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c2d\u0c3e\u0c37\u0c32\u0c4b \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c35\u0c3f\u0c37\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41. \u0c28\u0c47\u0c28\u0c41 \u0c28\u0c3e \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d/\u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c4a\u0c28\u0c4d\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c15\u0c41 \u0c28\u0c3e \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c28\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c28\u0c41.","T&C_11":"\u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41: \u0c2a\u0c4d\u0c30\u0c25\u0c2e\u0c4d \u0c0e\u0c21\u0c4d\u0c2f\u0c41\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2b\u0c4c\u0c02\u0c21\u0c47\u0c37\u0c28\u0c4d",office_adrress:"\u0c22\u0c3f\u0c32\u0c4d\u0c32\u0c40 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c3e\u0c32\u0c2f\u0c02: B4/59, \u0c38\u0c2b\u0c4d\u0c26\u0c30\u0c4d\u200c\u0c1c\u0c02\u0c17\u0c4d \u0c0e\u0c28\u0c4d\u200c\u0c15\u0c4d\u0c32\u0c47\u0c35\u0c4d, \u0c28\u0c4d\u0c2f\u0c42 \u0c22\u0c3f\u0c32\u0c4d\u0c32\u0c40-110029",office_email:"\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d: dataprotectionofficer@pratham.org",office_phone:"\u0c2b\u0c4b\u0c28\u0c4d \u0c28\u0c02: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0c28\u0c47\u0c28\u0c41 \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c26\u0c3f\u0c35\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c2b\u0c3e\u0c30\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c28\u0c3e \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c21\u0c47\u0c1f\u0c3e \u0c38\u0c47\u0c15\u0c30\u0c23 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c28\u0c41.","T&C_13":"\u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c4b\u0c28\u0c3f '\u0c21\u0c47\u0c1f\u0c3e & \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02'\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c0e\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c48\u0c28\u0c3e \u0c21\u0c47\u0c1f\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c2a\u0c41, \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",username_already_exists:"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c02\u0c26\u0c3f",username_is_already_exists_in_keycloak:"\u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c2a\u0c47\u0c30\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c02\u0c26\u0c3f",something_went_wrong_try_again_later:"\u0c0f\u0c26\u0c4b \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c1c\u0c30\u0c3f\u0c17\u0c3f\u0c02\u0c26\u0c3f, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",Learning_Content:"\u0c05\u0c2d\u0c4d\u0c2f\u0c3e\u0c38 \u0c15\u0c02\u0c1f\u0c46\u0c02\u0c1f\u0c4d",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0c2e\u0c40 \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c24\u0c4d\u0c24\u0c2e \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24\u0c32\u0c28\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f!",Based_on_Your_Interests:"\u0c2e\u0c40 \u0c06\u0c38\u0c15\u0c4d\u0c24\u0c41\u0c32 \u0c06\u0c27\u0c3e\u0c30\u0c02\u0c17\u0c3e",view_all:"\u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c38\u0c3e\u0c15\u0c4d\u0c37\u0c30\u0c24",Financial_Literacy:"\u0c2a\u0c20\u0c28 \u0c15\u0c4a\u0c28\u0c3