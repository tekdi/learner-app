etails:"\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0924\u0940\u0932 \u0938\u0926\u0938\u094d\u092f\u093e\u0902\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940",spouse_name:"\u092a\u0924\u094d\u0928\u093f/\u092a\u0924\u0940\u091a\u0947 \u0928\u093e\u0935",father_name:"\u0935\u0921\u093f\u0932\u093e\u0902\u091a\u0947 \u0928\u093e\u0935",nophone:"\u092b\u094b\u0928 \u0928\u093e\u0939\u0940","###ATM###":"###ATM###",online_assessment:"\u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928",offline_assessment:"\u0911\u092b\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928",Total_Assessment:"\u090f\u0915\u0942\u0923 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928",Total_Assessments:"\u090f\u0915\u0942\u0923 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u0947",no_offline_assessments_available:"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0911\u092b\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940\u0924",no_online_assessments_available:"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940\u0924",not_submitted:"\u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0947 \u0928\u093e\u0939\u0940",submitted_eval:"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u093e\u0938\u093e\u0920\u0940 \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0947",published_on:"\u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0947\u0932\u0947",Explanation:"\u0938\u094d\u092a\u0937\u094d\u091f\u0940\u0915\u0930\u0923","See less":"\u0915\u092e\u0940 \u092a\u0939\u093e","See more":"\u0905\u0927\u093f\u0915 \u092a\u0939\u093e",Marks:"\u0917\u0941\u0923","Approve Marks & Notify Learner":"\u0917\u0941\u0923 \u092e\u0902\u091c\u0942\u0930 \u0915\u0930\u093e \u0906\u0923\u093f \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u093e","Fill in the Blanks":"\u0930\u093f\u0915\u094d\u0924 \u0938\u094d\u0925\u093e\u0928\u0947 \u092d\u0930\u093e","Multiple Choice Questions":"\u092c\u0939\u0941\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092a\u094d\u0930\u0936\u094d\u0928","Short Answer Questions":"\u0932\u0918\u0941 \u0909\u0924\u094d\u0924\u0930\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928","Long Answer Questions":"\u0926\u0940\u0930\u094d\u0918 \u0909\u0924\u094d\u0924\u0930\u0940\u092f \u092a\u094d\u0930\u0936\u094d\u0928","Unknown Section":"\u0905\u091c\u094d\u091e\u093e\u0924 \u0935\u093f\u092d\u093e\u0917","No assessment data available":"\u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940","Please check if the assessment has been completed and try again":"\u0915\u0943\u092a\u092f\u093e \u0924\u092a\u093e\u0938\u093e \u0915\u0940 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947 \u0915\u093e \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e","AnswerSheet Component is Rendering":"\u0909\u0924\u094d\u0924\u0930\u092a\u0924\u094d\u0930\u093f\u0915\u093e \u0918\u091f\u0915 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0924 \u0906\u0939\u0947","But no assessment data available":"\u092a\u0930\u0902\u0924\u0941 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940","No Images Uploaded":"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0940 \u0928\u093e\u0939\u0940","Uploaded Images":"\u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092e\u093e","Remove Image":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u093e","Are you sure you want to remove this image?":"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u093e \u0915\u0940 \u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u093e\u092f\u091a\u0940 \u0906\u0939\u0947?","Selected Images":"\u0928\u093f\u0935\u0921\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092e\u093e",images:"\u092a\u094d\u0930\u0924\u093f\u092e\u093e","You have selected":"\u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u093f\u0935\u0921\u0932\u0947 \u0906\u0939\u0947","For better performance, we recommend uploading up to 20 images at a time":"\u091a\u093e\u0902\u0917\u0932\u094d\u092f\u093e \u0915\u093e\u092e\u0917\u093f\u0930\u0940\u0938\u093e\u0920\u0940, \u0906\u092e\u094d\u0939\u0940 \u090f\u0915\u093e \u0935\u0947\u0933\u0940 \u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924 20 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0930\u0924\u094b","Add More Images":"\u0905\u0927\u093f\u0915 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u091c\u094b\u0921\u093e","No images uploaded":"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0940 \u0928\u093e\u0939\u0940","Images Selected":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u0932\u094d\u092f\u093e",Recommended:"\u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0947\u0932\u0947\u0932\u0947","Submit Answers for AI Evaluation":"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u0938\u093e\u0926\u0930 \u0915\u0930\u093e","Take Photo":"\u092b\u094b\u091f\u094b \u0915\u093e\u0922\u093e","Choose from Gallery":"\u0917\u0945\u0932\u0930\u0940\u092e\u0927\u0942\u0928 \u0928\u093f\u0935\u0921\u093e","Format: jpg, size: 50 MB":"\u0938\u094d\u0935\u0930\u0942\u092a: jpg, \u0906\u0915\u093e\u0930: 50 MB","Up to 20 images":"\u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924 20 \u092a\u094d\u0930\u0924\u093f\u092e\u093e","Exam Instructions":"\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e","Re-verify the image after selection. Once submitted for evaluation, it cannot be resubmitted.":"\u0928\u093f\u0935\u0921\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u0924\u092a\u093e\u0938\u093e. \u090f\u0915\u0926\u093e \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928\u093e\u0938\u093e\u0920\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930 \u0924\u0940 \u092a\u0941\u0928\u094d\u0939\u093e \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.","Take a plain white paper":"\u090f\u0915 \u0938\u093e\u0927\u093e \u092a\u093e\u0902\u0922\u0930\u093e \u0915\u093e\u0917\u0926 \u0918\u094d\u092f\u093e","Use pen with black or blue ink only":"\u092b\u0915\u094d\u0924 \u0915\u093e\u0933\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e \u0928\u093f\u0933\u094d\u092f\u093e \u0936\u093e\u0908\u091a\u0947 \u092a\u0947\u0928 \u0935\u093e\u092a\u0930\u093e","Write all the answers, including MCQs and fill-in-the-blanks, on the piece of paper":"\u0938\u0930\u094d\u0935 \u0909\u0924\u094d\u0924\u0930\u0947, MCQs \u0906\u0923\u093f \u0930\u093f\u0915\u094d\u0924 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u091a\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u0915\u093e\u0917\u0926\u093e\u0935\u0930 \u0932\u093f\u0939\u093e","Use the same numbering system as the question paper; take extra care to write the numbers clearly":"\u092a\u094d\u0930\u0936\u094d\u0928\u092a\u0924\u094d\u0930\u093f\u0915\u0947\u092a\u094d\u0930\u092e\u093e\u0923\u0947\u091a \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u0928 \u092a\u0926\u094d\u0927\u0924 \u0935\u093e\u092a\u0930\u093e; \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0932\u093f\u0939\u093f\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0936\u0947\u0937 \u0915\u093e\u0933\u091c\u0940 \u0918\u094d\u092f\u093e.","Write clearly and make sure the letters do not touch the edges of the page. If a mistake is made, strike it out neatly and write it again":"\u0938\u094d\u092a\u0937\u094d\u091f \u0932\u093f\u0939\u093e \u0906\u0923\u093f \u0905\u0915\u094d\u0937\u0930\u0947 \u092a\u0943\u0937\u094d\u0920\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0920\u093e\u0935\u0930 \u0928\u093e\u0939\u0940\u0924 \u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e. \u091a\u0942\u0915 \u091d\u093e\u0932\u094d\u092f\u093e\u0938, \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u093e\u091f \u092e\u093e\u0930\u093e \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u0932\u093f\u0939\u093e","Processing...":"\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947\u0932\u0940 \u091c\u093e\u0924 \u0906\u0939\u0947...","Processing images...":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e\u0902\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947\u0932\u0940 \u091c\u093e\u0924 \u0906\u0939\u0947...","We recommend uploading up to 20 images":"\u0906\u092e\u094d\u0939\u0940 \u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924 20 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0930\u0924\u094b","Submit for Review":"\u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928\u093e\u0938\u093e\u0920\u0940 \u0938\u093e\u0926\u0930 \u0915\u0930\u093e",Uploading:"\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924 \u0906\u0939\u0947","Uploading Files":"\u092b\u093e\u0908\u0932 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924 \u0906\u0939\u0947","Images are successfully uploaded":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0905\u092a\u0932\u094b\u0921 \u091d\u093e\u0932\u094d\u092f\u093e","Failed to upload images. Please try again.":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.","No Images":"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093e\u0939\u0940","Please select images to upload.":"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.",Error:"\u0924\u094d\u0930\u0941\u091f\u0940","Failed to capture photo. Please try again.":"\u092b\u094b\u091f\u094b \u0915\u0945\u092a\u094d\u091a\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.","Failed to select images. Please try again.":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.","Your answers have been successfully submitted for evaluation":"\u0924\u0941\u092e\u091a\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928\u093e\u0938\u093e\u0920\u0940 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0940 \u0917\u0947\u0932\u0940 \u0906\u0939\u0947\u0924","You'll be notified as soon as the evaluation is complete.":"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u094d\u092f\u093e\u0935\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u0942\u091a\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0908\u0932.","In the meantime, make sure you've submitted all required answers correctly. If you face any issues, please reach out to your facilitator.":"\u0926\u0930\u092e\u094d\u092f\u093e\u0928, \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935 \u0906\u0935\u0936\u094d\u092f\u0915 \u0909\u0924\u094d\u0924\u0930\u0947 \u092f\u094b\u0917\u094d\u092f\u0930\u093f\u0924\u094d\u092f\u093e \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947\u0924 \u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e. \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u092f\u0947\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0936\u093f\u0915\u094d\u0937\u0915\u093e\u0902\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.","Loading assessment data...":"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u0921\u0947\u091f\u093e \u0932\u094b\u0921 \u0915\u0930\u0924 \u0906\u0939\u0947...","No assessment data available yet":"\u0905\u0926\u094d\u092f\u093e\u092a \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928 \u0921\u0947\u091f\u093e \u0909\u092a\u0932\u092c\u094d