_have_completed_the_course:"\u0622\u067e \u0646\u06d2 \u06a9\u0648\u0631\u0633 \u0645\u06a9\u0645\u0644 \u06a9\u0631 \u0644\u06cc\u0627 \u06c1\u06d2!",you_can_access_the_Certificate_at_any_time_from_your_rofile:"\u0622\u067e \u0627\u067e\u0646\u06d2 '\u067e\u0631\u0648\u0641\u0627\u0626\u0644' \u0633\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0633\u0631\u0679\u06cc\u0641\u06a9\u06cc\u0679 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba",view_more_courses:"\u0645\u0632\u06cc\u062f \u06a9\u0648\u0631\u0633\u0632 \u062f\u06cc\u06a9\u06be\u06cc\u06ba",contact_us:"\u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4",is_volunteer:"\u0631\u0636\u0627\u06a9\u0627\u0631 \u06c1\u06d2\u06d4",great_we_excited_to_help_you_level_up:"\u0628\u06c1\u062a \u0627\u0686\u06be\u0627! \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0645\u062f\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0631\u062c\u0648\u0634 \u06c1\u06cc\u06ba!",which_topic_are_you_most_interested_in:"\u0622\u067e \u06a9\u0648 \u06a9\u0633 \u0645\u0648\u0636\u0648\u0639 \u0645\u06cc\u06ba \u0633\u0628 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u062f\u0644\u0686\u0633\u067e\u06cc \u06c1\u06d2\u061f",select_course_desp:"\u0627\u06cc\u06a9 \u0628\u0627\u0631 \u062c\u0628 \u0622\u067e \u06a9\u0633\u06cc \u06a9\u0648\u0631\u0633 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u06c1\u0645\u0627\u0631\u0627 \u0645\u0627\u06c1\u0631 \u0645\u0632\u06cc\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0622\u067e \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06d2 \u06af\u0627!",submit:"\u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4",topics:"\u0645\u0648\u0636\u0648\u0639\u0627\u062a",lets_create_your_acc:"\u0622\u0626\u06cc\u06d2 \u0622\u06