939\u0947",download_complete:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092a\u0942\u0930\u094d\u0923",download_failed:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0905\u092f\u0936\u0938\u094d\u0935\u0940",download_starting:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0938\u0941\u0930\u0942 \u0939\u094b\u0924 \u0906\u0939\u0947... \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u093e",download_success_message:"\u092a\u094d\u0930\u0924\u093f\u092e\u093e Downloads/LearnerApp \u092e\u0927\u094d\u092f\u0947 \u0938\u0947\u0935 \u0915\u0947\u0932\u0940 ",download_failed_message:"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u0947 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",no_image_url:"\u0921\u093e\u0909\u0928\u0932\u094b\u0921\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e URL \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",permission_unavailable:"\u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",permission_unavailable_message:"\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930 \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",permission_blocked:"\u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u092c\u094d\u0932\u0949\u0915 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947",permission_blocked_message:"\u0938\u094d\u091f\u094b\u0930\u0947\u091c \u092a\u0930\u0935\u09