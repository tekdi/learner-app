u093e\u0915\u094d\u0937\u0930\u0924\u093e",CONCEPTUAL_THINKING:"\u0938\u0902\u0915\u0932\u094d\u092a\u0928\u093e\u0924\u094d\u092e\u0915 \u0935\u093f\u091a\u093e\u0930",ENVIRONMENT:"\u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923",CAREER_AWARENESS:"\u0915\u0930\u093f\u0905\u0930 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e",FUN:"\u092e\u091c\u093e",EFFECTIVE_COMMUNICATION:"\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0938\u0902\u0935\u093e\u0926",q6_login_cred:"\u0936\u0947\u0935\u091f\u0940, \u091a\u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u094d\u0930\u0947\u0921\u0947\u0902\u0936\u093f\u092f\u0932\u094d\u0938 \u0924\u092f\u093e\u0930 \u0915\u0930\u0942\u092f\u093e",lb_username:"\u0924\u0941\u092e\u091a\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e\u0928\u093e\u0935 \u0938\u093e\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u093e",lb_username_info:"\u0939\u0947 \u0932\u0949\u0917\u093f\u0928 \u0926\u0930\u092e\u094d\u092f\u093e\u0928 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0908\u0932",lb_username_error:"\u0924\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u091a\u093e \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0906\u0939\u0947",lb_pass:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921",confirm_password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e",customize_dashboard_message:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921 \u0938\u093e\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924 \u0906\u0939\u0947...",login:"\u0932\u0949\u0917\u093f\u0928",content:"\u0938\u093e\u092e\u0917\u094d\u0930\u0940",courses:"\u0905\u092d\u094d\u092f\u093e\u0938\u0915\u094d\u0930\u092e",profile:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",usersname:"\u0924\u0941\u092e\u091a\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u0935 \u0938\u093e\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u093e",username:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u0935",password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921",forgot_password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092d\u0942\u0932 \u0917\u092f\u093e",remember_me:"\u092e\u0932\u093e \u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u093e.",is_required:"\u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947",min:"\u0915\u093f\u092e\u093e\u0928",max:"\u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924",characters:"\u0905\u0915\u094d\u0937\u0930\u0947",Password_must_match:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091c\u0941\u0933\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947",can_only_contain_letters:"\u092b\u0915\u094d\u0924 \u0905\u0915\u094d\u0937\u0930\u0947 \u0905\u0938\u0942 \u0936\u0915\u0924\u093e\u0924",Choose_at_least:"\u0915\u093f\u092e\u093e\u0928 \u0928\u093f\u0935\u0921\u093e",cards_can_be_selected:"\u0915\u093e\u0930\u094d\u0921 \u0928\u093f\u0935\u0921\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924",terms_and_conditions:"\u0936\u0947\u0935\u091f\u0940, \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0905\u0928\u0941\u0930\u0942\u092a \u0905\u0928\u0941\u092d\u0935 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u0935\u092f \u0915\u0933\u0935\u093e. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926\u093e\u092e\u0941\u0933\u0947 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u092f\u094b\u0917\u094d\u092f \u0905\u091f\u0940 \u0906\u0923\u093f \u0936\u0930\u094d\u0924\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0939\u094b\u0908\u0932.",I_am_18_or_older:"\u092e\u0940 18 \u0915\u093f\u0902\u0935\u093e \u0924\u094d\u092f\u093e\u0939\u0942\u0928 \u092e\u094b\u0920\u093e \u0906\u0939\u0947",I_am_under_18:"\u092e\u0940 18 \u0935\u0930\u094d\u0937\u093e\u0916\u093e\u0932\u0940\u0932 \u0906\u0939\u0947","T&C":"\u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0932\u0940\u0932 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923 \u0905\u0916\u0947\u0930\u092a\u0930\u094d\u092f\u0902\u0924 \u0938\u094d\u0915\u094d\u0930\u094b\u0932 \u0915\u0930\u0942\u0928 \u0935\u093e\u091a\u093e, \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0915\u094d\u0937\u092e \u0939\u094b\u090a \u0936\u0915\u093e\u0932.",create_account:"\u0916\u093e\u0924\u0947 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e",button:"\u092c\u091f\u0923","T&C_1":"\u092a\u094d\u0930\u0925\u092e \u090f\u091c\u094d\u092f\u0941\u0915\u0947\u0936\u0928 \u092b\u093e\u0909\u0902\u0921\u0947\u0936\u0928 (\u092a\u094d\u0930\u0925\u092e) \u0939\u0940 \u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u094d\u092f\u093e \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0940 \u0938\u0902\u0938\u094d\u0925\u093e\u0902\u092a\u0948\u0915\u0940 \u090f\u0915 \u0906\u0939\u0947, \u091c\u094d\u092f\u093e\u091a\u0947 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092e\u0941\u0902\u092c\u0908 \u092f\u0947\u0925\u0947 \u0906\u0939\u0947, \u092a\u094d\u0930\u0925\u092e\u0928\u0947 25 \u0935\u0930\u094d\u0937\u093e\u0902\u0939\u0942\u0928 \u0905\u0927\u093f\u0915 \u0915\u093e\u0933 \u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924 \u0915\u093e\u092e \u0915\u0947\u0932\u0947 \u0906\u0939\u0947.","T&C_2":"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0939\u0947 \u0915\u0940, \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u094d\u0930\u0925\u092e\u0928\u0947 \u0906\u092f\u094b\u091c\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0909\u092a\u0915\u094d\u0930\u092e\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092d\u093e\u0917 \u0918\u0947\u0924 \u0906\u0939\u093e\u0924. \u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924, \u092a\u094d\u0930\u0925\u092e \u0906\u092a\u0932\u094d\u092f\u093e \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940\u0902\u091a\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0906\u092a\u0932\u093e \u0921\u0947\u091f\u093e \u0917\u094b\u0933\u093e \u0915\u0930\u0947\u0932 \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0915\u094d\u0930\u093f\u092f\u093e\u0915\u0932\u093e\u092a\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092d\u093e\u0917 \u0918\u0947\u0924\u093e\u0928\u093e \u092e\u0942\u0932\u092d\u0942\u0924 \u0913\u0933\u0916, \u0938\u094d\u0925\u093e\u0928, \u0938\u0902\u092a\u0930\u094d\u0915 \u092e\u093e\u0939\u093f\u0924\u0940, \u0936\u093f\u0915\u0923\u094d\u092f\u093e\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0921\u0947\u091f\u093e, \u092a\u094d\u0930\u0924\u093f\u092e\u093e/\u091b\u093e\u092f\u093e\u091a\u093f\u0924\u094d\u0930\u0947, \u0935\u094d\u0939\u093f\u0921\u093f\u0913, \u0935\u094d\u0939\u0949\u0908\u0938 \u0930\u0947\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 ('\u0938\u093e\u0939\u093f\u0924\u094d\u092f') \u092f\u093e\u0902\u091a\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0906\u0939\u0947 \u092a\u0930\u0902\u0924\u0941 \u0907\u0924\u0915\u0947\u091a \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0928\u093e\u0939\u0940.","T&C_3":"\u0917\u094b\u0933\u093e \u0915\u0947\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940/\u0938\u093e\u0939\u093f\u0924\u094d\u092f \u0916\u093e\u0932\u0940\u0932 \u0915\u093e\u0930\u0923\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u0902\u0936\u0924\u0903 \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0935\u093e\u092a\u0930\u0932\u0947 \u091c\u093e\u0908\u0932\u0903","T&C_4":"1. \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u093e\u091a\u0940 \u0905\u0902\u092e\u0932\u092c\u091c\u093e\u0935\u0923\u0940 \u0906\u0923\u093f \u0938\u0941\u0927\u093e\u0930\u0923\u093e, \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u0938\u0939\u092d\u093e\u0917 \u0906\u0923\u093f \u0905\u0939\u0935\u093e\u0932\u093e\u091a\u0940 \u0909\u0926\u094d\u0926\u093f\u0937\u094d\u091f\u0947.","T&C_5":"2. \u092a\u094d\u0930\u0925\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u0928\u093e\u0902\u092e\u0927\u094d\u092f\u0947, \u0926\u0947\u0923\u0917\u0940\u0926\u093e\u0930 \u0905\u0939\u0935\u093e\u0932 (\u092d\u093e\u0930\u0924\u093e\u0924 \u0924\u0938\u0947\u091a \u0906\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u094d\u0924\u0930\u093e\u0935\u0930), \u092a\u094d\u0930\u0938\u093e\u0930\u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0902\u091a\u0947 \u0909\u092a\u0915\u094d\u0930\u092e, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0902\u091a\u0947 \u0909\u092a\u0915\u094d\u0930\u092e (\u0909\u0926\u093e. : \u092b\u0947\u0938\u092c\u0941\u0915, \u092f\u0942\u091f\u094d\u092f\u0942\u092c, \u0907\u0928\u094d\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e, \u0932\u093f\u0902\u0915\u094d\u0921\u0907\u0928, \u091f\u094d\u0935\u093f\u091f\u0930, \u0925\u094d\u0930\u0947\u0921\u094d\u0938 \u0907. ), \u0921\u093f\u091c\u093f\u091f\u0932 \u092e\u0902\u091a\u093e\u0902\u0935\u0930\u0940\u0932 \u0909\u092a\u0915\u094d\u0930\u092e (\u0909\u0926\u093e. : \u092a\u094d\u0930\u0925\u092e\u091a\u0940 \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u0947). \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u0909\u092a\u0915\u094d\u0930\u092e\u093e\u0902\u0935\u093f\u0937\u092f\u0940 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u093e\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932.","T&C_6":"3. \u092a\u094d\u0930\u0925\u092e\u091a\u094d\u092f\u093e \u0927\u0930\u094d\u092e\u093e\u0926\u093e\u092f \u0915\u093e\u0930\u094d\u092f\u093e\u092c\u0926\u094d\u0926\u0932 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0926\u0947\u0923\u0917\u0940\u0926\u093e\u0930\u093e\u0902\u0936\u0940 (\u092d\u093e\u0930\u0924\u093e\u0924 \u0924\u0938\u0947\u091a \u0906\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u094d\u0924\u0930\u093e\u0935\u0930) \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0923\u0947.","T&C_7":"\u0935\u0930 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u0940 \u092e\u093e\u0939\u093f\u0924\u0940/\u0938\u093e\u0939\u093f\u0924\u094d\u092f \u0917\u094b\u0933\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0938\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u0941\u092e\u091a\u0940 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947. \u0924\u0925\u093e\u092a\u093f, \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0935\u0947\u0915\u092c\u0941\u0926\u094d\u0927\u0940\u0928\u0941\u0938\u093e\u0930, \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940/\u0938\u093e\u0939\u093f\u0924\u094d\u092f \u0917\u094b\u0933\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0940 \u0938\u0902\u092e\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0942 \u0936\u0915\u0924\u093e.","T&C_8":"\u092e\u0940 \u092a\u094d\u0930\u0925\u092e, \u0924\u094d\u092f\u093e\u091a\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940\u0902\u0928\u093e \u092e\u093e\u091d\u094d\u092f\u093e\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u0930\u0940\u0932 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u091c\u092c\u0930\u0926\u0938\u094d\u0924\u0940\u0936\u093f\u0935\u093e\u092f \u0935\u093e\u092a\u0930\u0923\u094d\u092f\u093e\u0938, \u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938, \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938, \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0924\u094b.","T&C_9":"\u091c\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u094d\u0937\u0923\u0940 \u092e\u0940 \u092e\u093e\u091d\u093e \u0921\u0947\u091f\u093e/\u092b\u094b\u091f\u094b/\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u092a\u094d\u0930\u0925\u092e\u091a\u094d\u092f\u093e \u0938\u0902\u0915\u0947\u0924\u0938\u094d\u0925\u0933\u093e\u0935\u0930\u0942\u0928 \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u0920\u0935\u0923 \u092e\u0902\u091a\u093e\u0935\u0930\u0942\u0928 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u093e\u0935\u093e, \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e\u0935\u093e \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u093e\u0935\u093e \u0905\u0938\u0947 \u0920\u0930\u0935\u0932\u0947 \u0924\u0930 \u092e\u0940 \u092a\u094d\u0930\u0925\u092e\u091a\u094d\u092f\u093e \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940\u0932\u093e \u092b\u094b\u0928/\u0908\u092e\u0947\u0932\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0933\u0935\u0940\u0928, \u091c\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0932\u0947\u0916\u0940 \u092e\u093e\u0918\u093e\u0930/\u0938\u0902\u092e\u0924\u0940 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u0947. \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u092a\u094d\u0930\u0925\u092e, \u0924\u094d\u092f\u093e\u091a\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940 15 \u0915\u093e\u092e\u0915\u093e\u091c\u093e\u091a\u094d\u092f\u093e \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0924 \u0924\u0947 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u0924\u0940\u0932 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u0924\u0940\u0932/\u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u0924\u0940\u0932. \u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 \u0938\u0902\u092a\u0930\u094d\u0915 \u0924\u092a\u0936\u0940\u0932 \u0916\u093e\u0932\u0940 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u093e \u0906\u0939\u0947.","T&C_10":"\u092e\u0940 \u0935\u0930\u0940\u0932 \u0917\u094b\u0937\u094d\u091f\u0940 \u0935\u093e\u091a\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u093e\u0937\u0947\u0924 \u0938\u092e\u091c\u093e\u0935\u0942\u0928 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u0905\u091f\u0940\u0902\u091a\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0938\u092e\u091c\u0942\u0928 \u0918\u0947\u0924\u0932\u0940 \u0906\u0939\u0947. \u092e\u0940 \u092f\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u092e\u093e\u091d\u094d\u092f\u093e \u0938\u093e\u0939\u093f\u0924\u094d\u092f/\u092e\u093e\u0939\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0935\u093e\u092a\u0930\u093e\u091a\u094d\u092f\u093e \u0935\u0930 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0905\u091f\u0940\u0902\u0938\u093e\u0920\u0940 \u092e\u093e\u091d\u094d\u092f\u093e \u0938\u0902\u092e\u0924\u0940\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u094b \u0906\u0923\u093f \u0905\u0936\u093e \u0935\u093e\u092a\u0930\u093e\u091a\u094d\u092f\u093e \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0926\u093e\u0935\u093e \u0915\u0930\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.","T&C_11":"\u0938\u0902\u092a\u0930\u094d\u0915\u093e\u091a\u093e \u0924\u092a\u0936\u0940\u0932\u0903 \u092a\u094d\u0930\u0925\u092e \u090f\u091c\u094d\u092f\u0941\u0915\u0947\u0936\u0928 \u092b\u093e\u090a\u0902\u0921\u0947\u0936\u0928",office_adrress:"\u0926\u093f\u0932\u094d\u0932\u0940 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u0903 \u092c\u0940 4/59, \u0938\u092b\u0926\u0930\u091c\u0902\u0917 \u090f\u0928\u094d\u0915\u094d\u0932\u0947\u0935\u094d\u0939, \u0928\u0935\u0940 \u0926\u093f\u0932\u094d\u0932\u0940-110029",office_email:"\u0908\u092e\u0947\u0932\u0903:dataprotectionofficer@pratham.org",office_phone:"\u092b\u094b\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915: 011-26177200",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u092e\u0940 \u0938\u0902\u092e\u0924\u0940 \u092b\u0949\u0930\u094d\u092e\u092e\u0927\u094d\u092f\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u092e\u093e\u091d\u093e \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0921\u0947\u091f\u093e \u0917\u094b\u0933\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0906\u0923\u093f \u0935\u093e\u092a\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u0902\u092e\u0924\u0940 \u0926\u093f\u0932\u0940 \u0906\u0939\u0947.","T&C_13":"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930\u0940\u0932 '\u0921\u0947\u091f\u093e \u0905\u0901\u0921 \u092a\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u0938\u0940 \u0938\u0947\u0902\u091f\u0930' \u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0902\u092a\u0930\u094d\u0915 \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u092e\u0927\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0927\u0940\u0939\u0940 \u0921\u0947\u091f\u093e \u0939\u091f\u0935\u0923\u094d\u092f\u093e\u091a\u0940, \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u093f\u0902\u0935\u093e \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",username_already_exists:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e\u0928\u093e\u0935 \u0906\u0927\u0940\u091a \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0906\u0939\u0947",username_is_already_exists_in_keycloak:"\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e\u0928\u093e\u0935 \u0906\u0927\u0940\u091a \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0906\u0939\u0947",something_went_wrong_try_again_later:"\u0924\u0915\u0928\u0940\u0915\u0940 \u0924\u094d\u0930\u0941\u091f\u093f, \u0915\u0943\u092a\u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",Learning_Content:"\u0936\u093f\u0915\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u092b\u0915\u094d\u0924 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u0928\u093f\u0935\u0921\u0940 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0940 \u092a\u094d\u0930\u093e\u0927\u093e\u0928\u094d\u092f\u0947 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0915\u0930\u093e!",Based_on_Your_Interests:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0935\u0921\u0940\u0928\u0941\u0938\u093e\u0930",view_all:"\u0938\u0930\u094d\u0935 \u092a\u0939\u093e",Financial_Literacy:"\u0906\u0930\u094d\u0925\u093f\u0915 \u0938\u093e\u0915\u094d\u0937\u0930\u0924\u093e",Continue_Learning:"\u0936\u093f\u0915\u0923\u0947 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e",Preferences:"\u092a\u094d\u0930\u093e\u0927\u093e\u0928\u094d\u092f\u0947",Food_Production:"\u0905\u0928\u094d\u0928 \u0909\u0924\u094d\u092a\u093e\u0926\u0928",Conceptual_Thinking:"\u0938\u0902\u0915\u0932\u094d\u092a\u0928\u093e\u0924\u094d\u092e\u0915 \u0935\u093f\u091a\u093e\u0930",Todays_Top_Pick:"\u0906\u091c\u091a\u0940 \u0938\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0928\u093f\u0935\u0921",Art:"\u0915\u0932\u093e",Assessments:"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928",assessment:"\u092e\u0942\u0932\u094d\u092f\u092e\u093e\u092a\u0928","pre-test":"\u092a\u094d\u0930\u0940 \u091f\u0947\u0938\u094d\u091f","post-test":"\u092a\u094b\u0938\u094d\u091f \u091f\u0947\u0938\u094d\u091f",Inprogress:"\u092a\u094d\u0930\u0917\u0924\u0940\u092a\u0925\u093e\u0935\u0930",Overallscore:"\u090f\u0915\u0942\u0923 \u0917\u0941\u0923\u093e\u0902\u0915:",completed:"\u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u0947",take_the_test:"\u091a\u093e\u091a\u0923\u0940 \u0918\u094d\u092f\u093e",not_started:"\u0938\u0941\u0930\u0942 \u0915\u0947\u0932\u0947 \u0928\u093e\u0939\u0940",submitted_On:"\u0935\u0930 \u0938\u093e\u0926\u0930 \u0915\u0947\u0932\u0947 :",reading:"\u0935\u093e\u091a\u0928",out_of:"\u092a\u0948\u0915\u0940",correct_answers:"\u092f\u094b\u0917\u094d\u092f \u0909\u0924\u094d\u0924\u0930\u0947",assessment_note:"\u091f\u0940\u092a\u0903 \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935 \u0935\u093f\u0937\u092f \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0947 \u0924\u0930\u091a \u0924\u0941\u092e\u091a\u0940 \u092a\u0942\u0930\u094d\u0935\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0935\u093f\u091a\u093e\u0930\u093e\u0924 \u0918\u0947\u0924\u0932\u0940 \u091c\u093e\u0908\u0932.",assessment_instructions:"\u0916\u093e\u0932\u0940\u0932 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u093f\u0937\u092f\u093e\u091a\u094d\u092f\u093e \u091a\u093e\u091a\u0923\u094d\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u093e. \u0924\u0947 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u094d\u0930\u092e\u093e\u0928\u0947 \u0915\u0930\u093e\u092f\u0932\u093e \u092e\u094b\u0915\u0933\u094d\u092f\u093e \u092e\u0928\u093e\u0928\u0947.",instruction1:"\u0915\u093e\u0932\u093e\u0935\u0927\u0940\u0903 \u091a\u093e\u091a\u0923\u0940 \u0935\u0947\u0933\u092c\u0926\u094d\u0927 \u0906\u0939\u0947 \u0906\u0923\u093f 20 \u092e\u093f\u0928\u093f\u091f\u0947 \u091a\u093e\u0932\u0947\u0932. \u0915\u0943\u092a\u092f\u093e \u0924\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0924\u0941\u092e\u091a\u093e \u0935\u0947\u0933 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e.",instruction2:"\u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u091a\u0940 \u0938\u0902\u0916\u094d\u092f\u093e\u0903 \u091a\u093e\u091a\u0923\u0940\u092e\u0927\u094d\u092f\u0947 \u092c\u0939\u0941\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092a\u094d\u0930\u0936\u094d\u0928 \u0905\u0938\u0924\u093e\u0924. \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093e\u0932\u092e\u0930\u094d\u092f\u093e\u0926\u0947\u0924 \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935 \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u091a\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u0926\u093f\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e.",instruction3:"\u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u0947\u0903 \u0924\u0941\u092e\u094d\u0939\u0940 \u092b\u0915\u094d\u0924 \u090f\u0915\u0926\u093e\u091a \u091a\u093e\u091a\u0923\u0940 \u0938\u093e\u0926\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0909\u0924\u094d\u0924\u0930\u093e\u0902\u091a\u0947 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e, \u0915\u093e\u0930\u0923 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u093e\u0926\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0926\u0941\u0938\u0930\u0940 \u0938\u0902\u0927\u0940 \u092e\u093f\u0933\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",instruction4:"\u091a\u093e\u091a\u0923\u0940 \u0938\u0941\u0930\u0942 \u0915\u0930\u0923\u0947\u0903 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0905\u0921\u0925\u0933\u094d\u092f\u093e\u0936\u093f\u0935\u093e\u092f \u0936\u093e\u0902\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u093e\u0924 \u0906\u0939\u093e\u0924 \u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e. \u0924\u0941\u092e\u091a\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u091c\u094b\u0921\u0923\u0940 \u0938\u094d\u0925\u093f\u0930 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e.",instruction5:"\u091a\u093e\u091a\u0923\u0940 \u092e\u093e\u0930\u094d\u0917\u0940 \u0932\u093e\u0935\u0923\u0947\u0903 \u0924\u0941\u092e\u091a\u0947 \u0909\u0924\u094d\u0924\u0930 \u0928\u093f\u0935\u0921\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0935\u093e\u091a\u093e. \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u094d\u0930\u0936\u094d\u0928 \u091f\u093e\u0933\u0942 \u0936\u0915\u0924\u093e \u0906\u0923\u093f \u0917\u0930\u091c \u092d\u093e\u0938\u0932\u094d\u092f\u093e\u0938 \u0928\u0902\u0924\u0930 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u092a\u0930\u0924 \u092f\u0947\u090a \u0936\u0915\u0924\u093e, \u092a\u0930\u0902\u0924\u0941 \u091f\u093e\u0907\u092e\u0930\u0935\u0930 \u0932\u0915\u094d\u0937 \u0920\u0947\u0935\u093e. \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u091a\u094d\u092f\u093e \u0926\u0930\u092e\u094d\u092f\u093e\u0928 \u0928\u0947\u0935\u094d\u0939\u093f\u0917\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0940\u0932 \u0906\u0923\u093f \u092e\u093e\u0917\u0940\u0932 \u092c\u091f\u0923\u0947 \u0935\u093e\u092a\u0930\u093e.","Read_T_&_C":"\u092e\u0940 \u0935\u093e\u091a\u0932\u0947 \u0906\u0939\u0947 \u0906\u0923\u093f \u0938\u0939\u092e\u0924 \u0906\u0939\u0947",terms_and_conditions2:"\u0905\u091f\u0940 \u0906\u0923\u093f \u0936\u0930\u094d\u0924\u0940",no_data_found:"\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0922\u0933\u0932\u0940 \u0928\u093e\u0939\u0940",my_profile:"\u092e\u093e\u091d\u0947 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932",second_chance_program:"\u0926\u0941\u0938\u0930\u0940 \u0938\u0902\u0927\u0940 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e",logout:"\u0932\u0949\u0917\u0906\u0909\u091f \u0915\u0930\u093e",general_instructions:"\u0938\u0930\u094d\u0935\u0938\u093e\u0927