0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09ad\u09c1\u09b2\u09c7 \u0997\u09c7\u099b\u09c7\u09a8",remember_me:"\u0986\u09ae\u09be\u0995\u09c7 \u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09c1\u09a8",is_required:"\u098f\u099f\u09bf \u0986\u09ac\u09b6\u09cd\u09af\u0995",min:"\u09a8\u09cd\u09af\u09c2\u09a8\u09a4\u09ae",max:"\u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995",characters:"\u099a\u09b0\u09bf\u09a4\u09cd\u09b0",Password_must_match:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09ae\u09bf\u09b2\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b9\u09ac\u09c7",can_only_contain_letters:"\u098f\u099f\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0985\u0995\u09cd\u09b7\u09b0 \u09a5\u09be\u0995\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7",Choose_at_least:"\u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8",cards_can_be_selected:"\u0995\u09be\u09b0\u09cd\u09a1\u0997\u09c1\u09b2\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7",terms_and_conditions:"\u09b6\u09c7\u09b7\u09c7, \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u098f\u09ac\u0982 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c\u09a1 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7, \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09df\u09b8 \u099c\u09be\u09a8\u09bf\u09df\u09c7 \u09a6\u09bf\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09be\u09b8\u0999\u09cd\u0997\u09bf\u0995 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u09c7\u0964",I_am_18_or_older:"\u0986\u09ae\u09bf \u09e7\u09ee \u09ac\u09be \u09a4\u09be\u09b0 \u09ac\u09c7\u09b6\u09bf \u09ac\u099b\u09b0 \u09ac\u09df\u09b8\u09c0",I_am_under_18:"\u0986\u09ae\u09bf \u09e7\u09ee \u09ac\u099b\u09b0\u09c7\u09b0 \u0995\u09ae","T&C":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09c0\u099a\u09c7 \u09b8\u09cd\u0995\u09cd\u09b0\u09cb\u09b2 \u0995\u09b0\u09c7 \u09aa\u09b2\u09bf\u09b8\u09bf \u09aa\u09dc\u09c1\u09a8 \u098f\u09ac\u0982 \u09a4\u09be\u09b0\u09aa\u09b0",create_account:"\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8",button:"\u09ac\u09cb\u09a4\u09be\u09ae","T&C_1":"\u09aa\u09cd\u09b0\u09a5\u09ae \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09ab\u09be\u0989\u09a8\u09cd\u09a1\u09c7\u09b6\u09a8 (\u09aa\u09cd\u09b0\u09a5\u09ae) \u09ad\u09be\u09b0\u09a4\u09c7\u09b0 \u09ac\u09c3\u09b9\u09a4\u09cd\u09a4\u09ae \u098f\u09a8\u099c\u09bf\u0993\u0997\u09c1\u09b2\u09bf\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u0995\u099f\u09bf, \u09af\u09be\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u09be\u09b2\u09af\u09bc \u09ae\u09c1\u09ae\u09cd\u09ac\u0987\u09af\u09bc\u09c7\u0964 \u09aa\u09cd\u09b0\u09a5\u09ae \u09e8\u09eb \u09ac\u099b\u09b0\u09c7\u09b0\u0993 \u09ac\u09c7\u09b6\u09bf \u09b8\u09ae\u09af\u09bc \u09a7\u09b0\u09c7 \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7\u099b\u09c7\u0964","T&C_2":"\u0986\u09aa\u09a8\u09bf \u099c\u09be\u09a8\u09c7\u09a8, \u0986\u09aa\u09a8\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09bf\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae\u09c7 \u0985\u0982\u09b6\u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u099b\u09c7\u09a8\u0964 \u098f\u0987 \u09aa\u09cd\u09b0\u09c7\u0995\u09cd\u09b7\u09bf\u09a4\u09c7, \u09aa\u09cd\u09b0\u09a5\u09ae \u09a4\u09be\u09b0 \u09b8\u09cd\u09ac\u09c7\u099a\u09cd\u099b\u09be\u09b8\u09c7\u09ac\u0995/\u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09a7\u09bf\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09ac\u09c7, \u09af\u09be \u09aa\u09cd\u09b0\u09be\u09a5\u09ae\u09bf\u0995 \u09b6\u09a8\u09be\u0995\u09cd\u09a4\u0995\u09b0\u09a3, \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8, \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u09a4\u09a5\u09cd\u09af, \u09b6\u09bf\u0995\u09cd\u09b7\u09a3 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09a4\u09a5\u09cd\u09af, \u099b\u09ac\u09bf/\u09ab\u099f\u09cb\u0997\u09cd\u09b0\u09be\u09ab, \u09ad\u09bf\u09a1\u09bf\u0993, \u09ad\u09af\u09bc\u09c7\u09b8 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1\u09bf\u0982 (\u098f\u0987 '\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0') \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09a5\u09be\u0995\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964","T&C_3":"\u09b8\u0982\u0997\u09cd\u09b0\u09b9\u09bf\u09a4 \u09a4\u09a5\u09cd\u09af/\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0\u099f\u09bf \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u0997\u09c1\u09b2\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7:","T&C_4":"\u09e7. \u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09be\u09ae \u09ac\u09be\u09b8\u09cd\u09a4\u09ac\u09be\u09af\u09bc\u09a8 \u0993 \u0989\u09a8\u09cd\u09a8\u09a4\u09bf, \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09c3\u0995\u09cd\u09a4\u09a4\u09be \u098f\u09ac\u0982 \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09bf\u0982 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u0964","T&C_5":"\u09e8. \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09a8\u09be\u09af\u09bc, \u09a6\u09be\u09a4\u09be \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09c7 (\u09ad\u09be\u09b0\u09a4 \u0993 \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995\u09ad\u09be\u09ac\u09c7), \u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09be \u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae, \u09b8\u09cb\u09b6\u09cd\u09af\u09be\u09b2 \u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09be \u0995\u09be\u09b0\u09cd\u09af\u0995\u09cd\u09b0\u09ae (\u09af\u09c7\u09ae\u09a8: \u09ab\u09c7\u09b8\u09ac\u09c1\u0995, \u0987\u0989\u099f\u09bf\u0989\u09ac, \u0987\u09a8\u09b8\u09cd\u099f\u09be\u0997\u09cd\u09b0\u09be\u09ae, \u09b2\u09bf\u0999\u09cd\u0995\u09a1\u0987\u09a8, \u099f\u09c1\u0987\u099f\u09be\u09b0, \u09a5\u09cd\u09b0\u09c7\u09a1\u09b8 \u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf), \u09a1\u09bf\u099c\u09bf\u099f\u09be\u09b2 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 (\u09af\u09c7\u09ae\u09a8: \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f) \u09b8\u099a\u09c7\u09a4\u09a8\u09a4\u09be \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09a4\u09c7\u0964","T&C_6":"\u09e9. \u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 (\u09ad\u09be\u09b0\u09a4 \u0993 \u0986\u09a8\u09cd\u09a4\u09b0\u09cd\u099c\u09be\u09a4\u09bf\u0995\u09ad\u09be\u09ac\u09c7) \u09b8\u09be\u09a5\u09c7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09a6\u09be\u09a4\u09be\u09a6\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a6\u09be\u09a8\u09ae\u09c2\u09b2\u0995 \u0995\u09be\u099c\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u099a\u09c7\u09a4\u09a8\u09a4\u09be \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be\u0964","T&C_7":"\u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u0989\u09aa\u09b0\u09cb\u0995\u09cd\u09a4 \u09a4\u09a5\u09cd\u09af/\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09b8\u0982\u0997\u09cd\u09b0\u09b9, \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0993 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u09a4\u09ac\u09c7, \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u099a\u09cd\u099b\u09be \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0, \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af/\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09b8\u0982\u0997\u09cd\u09b0\u09b9\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964","T&C_8":"\u0986\u09ae\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae, \u09a4\u09be\u09b0 \u09b8\u09cd\u09ac\u09c7\u099a\u09cd\u099b\u09be\u09b8\u09c7\u09ac\u0995 \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09a7\u09bf\u09a6\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09bf\u099a\u09cd\u099b\u09bf, \u0986\u09ae\u09be\u09b0 \u0989\u09aa\u09b0\u09cb\u0995\u09cd\u09a4 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0/\u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9, \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3, \u09b6\u09c7\u09af\u09bc\u09be\u09b0, \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u0993 \u099a\u09be\u09aa \u099b\u09be\u09a1\u09bc\u09be\u0987\u0964","T&C_9":"\u09af\u09a6\u09bf \u0995\u0996\u09a8\u09cb \u0986\u09ae\u09bf \u099a\u09be\u0987 \u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u09a1\u09c7\u099f\u09be/\u099b\u09ac\u09bf/\u09ad\u09bf\u09a1\u09bf\u0993 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f \u09ac\u09be \u09b8\u09cd\u099f\u09cb\u09b0\u09c7\u099c \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be, \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09ac\u09be \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 \u0995\u09b0\u09be \u09b9\u09cb\u0995, \u09a4\u09ac\u09c7 \u0986\u09ae\u09bf \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09b8\u09cd\u09ac\u09c7\u099a\u09cd\u099b\u09be\u09b8\u09c7\u09ac\u0995/\u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09a7\u09bf\u0995\u09c7 \u09ab\u09cb\u09a8/\u0987\u09ae\u09c7\u0987\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u099c\u09be\u09a8\u09be\u09ac, \u09a4\u09be\u09b0\u09aa\u09b0 \u0986\u09ae\u09bf \u098f\u0995\u099f\u09bf \u09b2\u09bf\u0996\u09bf\u09a4 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09be\u09b9\u09be\u09b0/\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09c7\u09ac\u0964 \u09a4\u09be\u09b0\u09aa\u09b0\u09c7, \u09aa\u09cd\u09b0\u09a5\u09ae, \u09a4\u09be\u09b0 \u09b8\u09cd\u09ac\u09c7\u099a\u09cd\u099b\u09be\u09b8\u09c7\u09ac\u0995 \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09a7\u09bf\u09b0\u09be \u09a4\u09be \u09e7\u09eb \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09ac\u09c7 \u09ac\u09be \u09b8\u0982\u09b6\u09cb\u09a7\u09a8/\u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09ac\u09c7\u0964 \u098f\u0987 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7, \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09a8\u09c0\u099a\u09c7 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964","T&C_10":"\u0986\u09ae\u09bf \u09aa\u09a1\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982/\u0985\u09a5\u09ac\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09c0\u09af\u09bc \u09ad\u09be\u09b7\u09be\u09af\u09bc \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u09b0 \u09b6\u09b0\u09cd\u09a4\u0997\u09c1\u09b2\u09bf \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u098f\u09b0 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1 \u09aa\u09c1\u09b0\u09cb\u09aa\u09c1\u09b0\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09c7\u09b0\u09c7\u099b\u09bf\u0964 \u0986\u09ae\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u099b\u09bf\u0964","T&C_11":"\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3: \u09aa\u09cd\u09b0\u09a5\u09ae \u09b6\u09bf\u0995\u09cd\u09b7\u09be \u09ab\u09be\u0989\u09a8\u09cd\u09a1\u09c7\u09b6\u09a8",office_adrress:"\u09a6\u09bf\u09b2\u09cd\u09b2\u09bf \u0985\u09ab\u09bf\u09b8: B4/59, \u09b8\u09be\u09ab\u09a6\u09b0\u099c\u0982 \u098f\u09a8\u0995\u09cd\u09b2\u09c7\u09ad, \u09a8\u09bf\u0989 \u09a6\u09bf\u09b2\u09cd\u09b2\u09bf-\u09e7\u09e7\u09e6\u09e6\u09e8\u09ef",office_email:"\u0987\u09ae\u09c7\u0987\u09b2: dataprotectionofficer@pratham.org",office_phone:"\u09ab\u09cb\u09a8 \u09a8\u0982: \u09e6\u09e7\u09e7-\u09e8\u09ec\u09e7\u09ed\u09ed\u09e8\u09e6\u09e6",office_website:"| www.pratham.org |",office_cin:"CIN: U80101MH2002NPL136300","T&C_12":"\u0986\u09ae\u09bf \u09aa\u09a1\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf\u09a4\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u0986\u09ae\u09bf \u0986\u09ae\u09be\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0993 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf \u09af\u09c7\u09ad\u09be\u09ac\u09c7 \u0995\u09a8\u09b8\u09c7\u09a8\u09cd\u099f \u09ab\u09b0\u09cd\u09ae\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964","T&C_13":"\u0986\u09aa\u09a8\u09bf \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09ae\u09af\u09bc '\u09a1\u09c7\u099f\u09be & \u09aa\u09cd\u09b0\u09be\u0987\u09ad\u09c7\u09b8\u09bf \u09b8\u09c7\u09a8\u09cd\u099f\u09be\u09b0' \u09a5\u09c7\u0995\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7 \u09a1\u09c7\u099f\u09be \u09ae\u09c1\u099b\u09a4\u09c7, \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09ac\u09be \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",username_already_exists:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7\u0987 \u0986\u099b\u09c7",something_went_wrong_try_again_later:"\u0995\u09bf\u099b\u09c1 \u09ad\u09c1\u09b2 \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u09aa\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964",Learning_Content:"\u09b6\u09bf\u0995\u09cd\u09b7\u09a3 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0",Update_your_preferences_to_get_the_best_picks_just_for_you:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09c1\u09a8 \u09af\u09be\u09a4\u09c7 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c7\u09b0\u09be \u09aa\u099b\u09a8\u09cd\u09a6\u0997\u09c1\u09b2\u09bf \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc!",Based_on_Your_Interests:"\u0986\u09aa\u09a8\u09be\u09b0 \u0986\u0997\u09cd\u09b0\u09b9\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7",view_all:"\u09b8\u09ac\u0997\u09c1\u09b2\u09bf \u09a6\u09c7\u0996\u09c1\u09a8",Financial_Literacy:"\u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09af\u09bc \u09aa\u09a0\u09a8",Continue_Learning:"\u09b6\u09bf\u0995\u09cd\u09b7\u09a3 \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8",Preferences:"\u09aa\u099b\u09a8\u09cd\u09a6",Food_Production:"\u0996\u09be\u09a6\u09cd\u09af \u0989\u09ce\u09aa\u09be\u09a6\u09a8",Conceptual_Thinking:"\u09a7\u09be\u09b0\u09a3\u09be\u0997\u09a4 \u099a\u09bf\u09a8\u09cd\u09a4\u09be",Todays_Top_Pick:"\u0986\u099c\u0995\u09c7\u09b0 \u09b6\u09c0\u09b0\u09cd\u09b7 \u09aa\u099b\u09a8\u09cd\u09a6",Art:"\u09b6\u09bf\u09b2\u09cd\u09aa",Assessments:"\u09ae\u09c2\u09b2\u09cd\u09af\u09be\u09af\u09bc\u09a8",assessment:"\u09ae\u09c2\u09b2\u09cd\u09af\u09be\u09af\u09bc\u09a8","pre-test":"\u09aa\u09c2\u09b0\u09cd\u09ac\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be","post-test":"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09b6\u09c7\u09b7\u09c7",Inprogress:"\u099a\u09b2\u09ae\u09be\u09a8",Overallscore:"\u09ae\u09cb\u099f \u09b8\u09cd\u0995\u09cb\u09b0:",completed:"\u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8",take_the_test:"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09a6\u09bf\u09a8",not_started:"\u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc\u09a8\u09bf",submitted_On:"\u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7:",reading:"\u09aa\u09a1\u09bc\u09be",out_of:"\u098f\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7",correct_answers:"\u09b8\u09a0\u09bf\u0995 \u0989\u09a4\u09cd\u09a4\u09b0",assessment_note:"\u099f\u09c0\u0995\u09be: \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u099f\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09a4\u0996\u09a8\u0987 \u0997\u09cb\u09a8\u09be \u09b9\u09ac\u09c7 \u09af\u0996\u09a8 \u0986\u09aa\u09a8\u09bf \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ac\u09bf\u09b7\u09af\u09bc \u09b8\u09ae\u09be\u09aa\u09cd\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8\u0964",assessment_instructions:"\u09a8\u09c0\u099a\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ac\u09bf\u09b7\u09af\u09bc\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u099f\u09bf \u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09c1\u09a8\u0964 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u0985\u09b0\u09cd\u09a1\u09be\u09b0\u09c7 \u09b8\u09c7\u0997\u09c1\u09b2\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",instruction1:"\u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be: \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u098f\u0995\u099f\u09bf \u09b8\u09ae\u09af\u09bc \u09b8\u09c0\u09ae\u09bf\u09a4 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u098f\u09ac\u0982 \u09e8\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f \u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0 \u09b9\u09ac\u09c7\u0964 \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09b8\u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be \u0995\u09b0\u09c1\u09a8\u0964",instruction2:"\u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be: \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u098f\u0995\u09be\u09a7\u09bf\u0995 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09a8\u09bf\u09af\u09bc\u09c7 \u0997\u09a0\u09bf\u09a4\u0964 \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8\u0964",instruction3:"\u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be: \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u098f\u0995\u09ac\u09be\u09b0 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0\u0997\u09c1\u09b2\u09bf \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09a6\u09bf\u09af\u09bc\u09c7 \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09c1\u09a8, \u0995\u09be\u09b0\u09a3 \u0986\u09aa\u09a8\u09bf \u0986\u09ac\u09be\u09b0 \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964",instruction4:"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be: \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u09b6\u09be\u09a8\u09cd\u09a4 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u09c7 \u0986\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u0995\u09cb\u09a8\u09cb \u09ac\u09bf\u0998\u09cd\u09a8 \u09a8\u09c7\u0987\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09a8\u09cd\u099f\u09be\u09b0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09b8\u09cd\u09a5\u09bf\u09b0 \u0986\u099b\u09c7 \u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8\u0964",instruction5:"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u09b6\u09a8: \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09a6\u09bf\u09af\u09bc\u09c7 \u09aa\u09a1\u09bc\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0989\u09a4\u09cd\u09a4\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u0997\u09c1\u09b2\u09bf \u09b8\u09cd\u0995\u09bf\u09aa \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u098f\u09ac\u0982 \u09aa\u09b0\u09c7 \u09b8\u09c7\u0997\u09c1\u09b2\u09bf \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09a8\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u09a4\u09ac\u09c7 \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u099c\u09b0 \u09b0\u09be\u0996\u09c1\u09a8\u0964 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a8\u09c7\u09ad\u09bf\u0997\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u098f\u09ac\u0982 \u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0 \u09ac\u09cb\u09a4\u09be\u09ae\u0997\u09c1\u09b2\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964","Read_T_&_C":"\u0986\u09ae\u09bf \u09aa\u09a1\u09bc\u09c7\u099b\u09bf \u098f\u09ac\u0982 \u09b8\u09ae\u09cd\u09ae\u09a4 \u0986\u099b\u09bf",terms_and_conditions2:"\u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0",no_data_found:"\u0995\u09cb\u09a8\u0993 \u09a1\u09c7\u099f\u09be \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf",my_profile:"\u0986\u09ae\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2",second_chance_program:"\u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc \u09b8\u09c1\u09af\u09cb\u0997 \u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09be\u09ae",logout:"\u09b2\u0997 \u0986\u0989\u099f",general_instructions:"\u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be",test_medium:"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae",board:"\u09ac\u09cb\u09b0\u09cd\u09a1",start_test:"\u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8",block:"\u09ac\u09cd\u09b2\u0995",unit:"\u0987\u0989\u09a8\u09bf\u099f",enrollment_number:"\u098f\u09a8\u09b0\u09cb\u09b2\u09ae\u09c7\u09a8\u09cd\u099f \u09a8\u09ae\u09cd\u09ac\u09b0",contact_number:"\u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u09a8\u09ae\u09cd\u09ac\u09b0",class:"\u09b6\u09cd\u09b0\u09c7\u09a3\u09c0",last_passed_grade:"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u0989\u09a4\u09cd\u09a4\u09c0\u09b0\u09cd\u09a3 \u0997\u09cd\u09b0\u09c7\u09a1",age:"\u09ac\u09af\u09bc\u09b8",en:"EN",hi:"\u0939\u093f\u0902",ma:"\u092e",ba:"\u09ac\u09be",te:"\u0c24\u0c46.",ka:"\u0c95\u0cbe.",ta:"\u0ba4",gu:"\u0a