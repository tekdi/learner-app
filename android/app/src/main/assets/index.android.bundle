\u0926\u0930\u094d\u092d \u092e\u0947\u0902, \u092a\u094d\u0930\u0925\u092e \u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0906\u092a\u0915\u0947 \u092c\u091a\u094d\u091a\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u0941\u091b \u091c\u093e\u0928\u0915\u093e\u0930\u093f\u092f\u093e\u0901 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0947\u0917\u093e, \u091c\u0948\u0938\u0947 \u2013 \u092c\u091a\u094d\u091a\u0947 \u0915\u093e \u0928\u093e\u092e, \u092a\u093f\u0924\u093e/\u092e\u093e\u0924\u093e/\u0905\u092d\u093f\u092d\u093e\u0935\u0915 \u0915\u093e \u0928\u093e\u092e, \u0938\u094d\u0925\u093e\u0928, \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930, \u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940, \u092a\u0922\u093c\u0928\u0947 \u0915\u093e \u0938\u094d\u0924\u0930, \u092b\u094b\u091f\u094b, \u0935\u0940\u0921\u093f\u092f\u094b \u0914\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"\u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0915\u0940 \u0917\u0908 \u091c\u093e\u0928\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u093e \u0915\u0941\u091b \u0939\u093f\u0938\u094d\u0938\u093e \u092f\u093e \u092a\u0942\u0930\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e:\""}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"1. \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u0915\u094b \u091a\u0932\u093e\u0928\u0947/\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0928\u0947, \u0938\u092e\u0941\u0926\u093e\u092f \u0915\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u091c\u094b\u0921\u093c\u0928\u0947 \u0914\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0939\u0947\u0924\u0941\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"2. \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u0928\u094b\u0902 \u092e\u0947\u0902, \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0914\u0930 \u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0921\u094b\u0928\u0930\u094b\u0902 \u0915\u094b \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902, \u092e\u0940\u0921\u093f\u092f\u093e, \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e (\u092b\u0947\u0938\u092c\u0941\u0915, \u091f\u094d\u0935\u093f\u091f\u0930, \u0907\u0902\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e, \u0932\u093f\u0902\u0915\u094d\u0921\u0907\u0928, \u0925\u094d\u0930\u0947\u0921\u094d\u0938, \u0906\u0926\u093f) \u0914\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u094d\u0938 (\u092a\u094d\u0930\u0925\u092e \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f) \u090f\u0935\u0902 \u0938\u0940\u0916\u0928\u0947- \u0938\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u092b\u0948\u0932\u093e\u0928\u0947 \u0939\u0947\u0924\u0941\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"3. \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u0915\u093e\u092e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f, \u0905\u0902\u0924\u0930\u094d\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0921\u094b\u0928\u0930\u094d\u0938 \u0914\u0930 \u0905\u0928\u094d\u092f \u092a\u093e\u0930\u094d\u091f\u0928\u0930\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925) \u0932\u093e\u0928\u0947 \u0939\u0947\u0924\u0941\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"\u0906\u092a\u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0939\u0948 \u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0914\u0930 \u0905\u092a\u0928\u0947 \u092c\u091a\u094d\u091a\u0947 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0928\u0947, \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u0940\u0916\u0928\u0947- \u0938\u093f\u0916\u093e\u0928\u0947 \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0902\u0964 \u0939\u093e\u0932\u093e\u0902\u0915\u093f, \u0907\u091a\u094d\u091b\u093e \u0905\u0928\u0941\u0938\u093e\u0930, \u0906\u092a \u0905\u092a\u0928\u0940 \u0914\u0930 \u0905\u092a\u0928\u0947 \u092c\u091a\u094d\u091a\u0947 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092e\u0928\u093e \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10}],children:"\u092e\u0948\u0902, \u092a\u094d\u0930\u0925\u092e \u0914\u0930 \u0909\u0938\u0915\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902 \u0914\u0930/\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u094b \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0926\u092c\u093e\u0935 \u0915\u0947 \u092e\u0941\u091d\u0938\u0947 \u0914\u0930 \u092e\u0947\u0930\u0947 \u092c\u091a\u094d\u091a\u0947 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a\u0930\u094d\u092f\u0941\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932, \u091c\u092e\u093e, \u0938\u093e\u091d\u093e \u0924\u0925\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0924\u0940/\u0926\u0947\u0924\u093e \u0939\u0942\u0901\u0964 \u092f\u0926\u093f \u092e\u0948\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u092f\u0939 \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0924\u0940/\u0932\u0947\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u0907\u0938 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u092a\u094d\u0930\u0925\u092e \u0915\u0940 \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0938\u0947 \u0939\u091f\u093e\u092f\u093e, \u0905\u092a\u0921\u0947\u091f \u092f\u093e \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u0924\u094b \u092e\u0948\u0902 \u092a\u094d\u0930\u0925\u092e \u0915\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915/\u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0915\u094b \u092b\u094b\u0928/\u0908\u092e\u0947\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0942\u0902\u0917\u0940/\u0915\u0930\u0942\u0902\u0917\u093e, \u091c\u093f\u0938\u0915\u0947 \u092c\u093e\u0926 \u0932\u093f\u0916\u093f\u0924 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0939\u092e\u0924\u093f \u0915\u0940 \u0935\u093e\u092a\u0938\u0940/\u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0942\u0902\u0917\u0940/\u0915\u0930\u0942\u0902\u0917\u093e\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926, 15 \u0915\u093e\u0930\u094d\u092f \u0926\u093f\u0935\u0938\u094b\u0902 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092a\u094d\u0930\u0925\u092e \u0907\u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0917\u093e \u092f\u093e \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u0915\u0930\u0947\u0917\u093e/\u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0917\u093e\u0964"}),(0,u.jsx)(n.default,{style:[l.default.text,{marginTop:10,marginBottom:50}],children:"\u092e\u0948\u0902\u0928\u0947 \u0938\u092d\u0940 \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092a\u0922\u093c\u093e \u0914\u0930/\u092f\u093e \u092e\u0941\u091d\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u092e\u0948\u0902 \u0938\u092d\u0940 \u0928\u093f\u092f\u092e\u094b\u0902 \u0914\u0930 \u091c\u093e\u0928\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u092e\u091d\u0924\u0940/\u0938\u092e\u091d\u0924\u093e \u0939\u0942\u0901\u0964 \u092e\u0948\u0902\u0928\u0947 \u0907\u0938\u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0905\u092a\u0928\u0940 \u0914\u0930 \u0905\u092a\u0928\u0947 \u092c\u091a\u094d\u091a\u0947 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e\u0908 \u0917\u0908 \u0936\u0930\u094d\u0924\u094b\u0902 \u0