\u0abe\u0a82\u0a95\u0aa8",offline_assessment:"\u0a91\u0aab\u0ab2\u0abe\u0a87\u0aa8 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8",Total_Assessment:"\u0a95\u0ac1\u0ab2 \u0a86\u0a95\u0abe\u0ab0\u0aa3\u0ac0",Total_Assessments:"\u0a95\u0ac1\u0ab2 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8",no_offline_assessments_available:"\u0a95\u0acb\u0a88 \u0a91\u0aab\u0ab2\u0abe\u0a87\u0aa8 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0",no_online_assessments_available:"\u0a95\u0acb\u0a88 \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0",not_submitted:"\u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac7\u0ab2 \u0aa8\u0aa5\u0ac0",submitted_eval:"\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac7\u0ab2",published_on:"\u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab6\u0abf\u0aa4 \u0aa4\u0abe\u0ab0\u0ac0\u0a96",Explanation:"\u0ab8\u0aae\u0a9c\u0ac2\u0aa4\u0ac0","See less":"\u0a93\u0a9b\u0ac1\u0a82 \u0a9c\u0ac1\u0a93","See more":"\u0ab5\u0aa7\u0ac1 \u0a9c\u0ac1\u0a93",Marks:"\u0a97\u0ac1\u0aa3","Approve Marks & Notify Learner":"\u0aae\u0abe\u0ab0\u0acd\u0a95\u0acd\u0ab8 \u0aae\u0a82\u0a9c\u0ac2\u0ab0 \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ac0\u0a96\u0aa8\u0abe\u0ab0\u0aa8\u0ac7 \u0ab8\u0ac2\u0a9a\u0abf\u0aa4 \u0a95\u0ab0\u0acb","Fill in the Blanks":"\u0a96\u0abe\u0ab2\u0ac0 \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a93 \u0aad\u0ab0\u0acb","Multiple Choice Questions":"\u0aac\u0ab9\u0ac1\u0ab5\u0abf\u0aa7 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb","Short Answer Questions":"\u0a9f\u0ac2\u0a82\u0a95\u0abe \u0a9c\u0ab5\u0abe\u0aac \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb","Long Answer Questions":"\u0ab2\u0abe\u0a82\u0aac\u0abe \u0a9c\u0ab5\u0abe\u0aac \u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0acb","Unknown Section":"\u0a85\u0a9c\u0acd\u0a9e\u0abe\u0aa4 \u0ab5\u0abf\u0aad\u0abe\u0a97","No assessment data available":"\u0a95\u0acb\u0a88 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aa1\u0ac7\u0a9f\u0abe \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0","Please check if the assessment has been completed and try again":"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aaa\u0abe\u0ab8\u0acb \u0a95\u0ac7 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82 \u0a85\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.","AnswerSheet Component is Rendering":"\u0a86\u0aa8\u0acd\u0ab8\u0ab0\u0ab6\u0ac0\u0a9f \u0a98\u0a9f\u0a95 \u0ab0\u0ac7\u0aa8\u0acd\u0aa1\u0ab0 \u0aa5\u0a88 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7","But no assessment data available":"\u0aaa\u0ab0\u0a82\u0aa4\u0ac1 \u0a95\u0acb\u0a88 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aa1\u0ac7\u0a9f\u0abe \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0","No Images Uploaded":"\u0a95\u0acb\u0a88 \u0a9b\u0aac\u0ac0\u0a93 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0aa8\u0aa5\u0ac0","Uploaded Images":"\u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0a9b\u0aac\u0ac0\u0a93","Remove Image":"\u0a9b\u0aac\u0ac0 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0acb","Are you sure you want to remove this image?":"\u0ab6\u0ac1\u0a82 \u0aa4\u0aae\u0ac7 \u0a96\u0ab0\u0ac7\u0a96\u0ab0 \u0a86 \u0a9b\u0aac\u0ac0 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb?","Selected Images":"\u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac7\u0ab2\u0ac0 \u0a9b\u0aac\u0ac0\u0a93",images:"\u0a9b\u0aac\u0ac0\u0a93","You have selected":"\u0aa4\u0aae\u0ac7 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7","For better performance, we recommend uploading up to 20 images at a time":"\u0ab5\u0aa7\u0ac1 \u0ab8\u0abe\u0ab0\u0abe \u0aaa\u0acd\u0ab0\u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0aae\u0abe\u0a9f\u0ac7, \u0a85\u0aae\u0ac7 \u0a8f\u0a95 \u0ab8\u0aae\u0aaf\u0ac7 20 \u0a9b\u0aac\u0ac0\u0a93 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aad\u0ab2\u0abe\u0aae\u0aa3 \u0a95\u0ab0\u0ac0\u0a8f \u0a9b\u0ac0\u0a8f.","Add More Images":"\u0ab5\u0aa7\u0ac1 \u0a9b\u0aac\u0ac0\u0a93 \u0a89\u0aae\u0ac7\u0ab0\u0acb","No images uploaded":"\u0a95\u0acb\u0a88 \u0a9b\u0aac\u0ac0\u0a93 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0aa8\u0aa5\u0ac0.","Images Selected":"\u0a9b\u0aac\u0ac0\u0a93 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ac0",Recommended:"\u0aad\u0ab2\u0abe\u0aae\u0aa3 \u0a95\u0ab0\u0ac7\u0ab2","Submit Answers for AI Evaluation":"\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acb","Take Photo":"\u0aab\u0acb\u0a9f\u0acb \u0aaa\u0abe\u0aa1\u0acb","Choose from Gallery":"\u0a97\u0ac7\u0ab2\u0ac7\u0ab0\u0ac0\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb","Format: jpg, size: 50 MB":"\u0aab\u0acb\u0ab0\u0acd\u0aae\u0ac7\u0a9f: jpg, \u0a95\u0aa6: 50 MB","Up to 20 images":"20 \u0a9b\u0aac\u0ac0\u0a93 \u0ab8\u0ac1\u0aa7\u0ac0","Exam Instructions":"\u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0ac2\u0a9a\u0aa8\u0abe\u0a93","Re-verify the image after selection. Once submitted for evaluation, it cannot be resubmitted.":"\u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0 \u0aaa\u0a9b\u0ac0 \u0a9b\u0aac\u0ac0 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a9a\u0a95\u0abe\u0ab8\u0acb. \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0aa4\u0ac7\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aa4\u0ac0 \u0aa8\u0aa5\u0ac0.","Take a plain white paper":"\u0a8f\u0a95 \u0ab8\u0abe\u0aa6\u0acb \u0ab8\u0aab\u0ac7\u0aa6 \u0a95\u0abe\u0a97\u0ab3 \u0ab2\u0acb.","Use pen with black or blue ink only":"\u0aab\u0a95\u0acd\u0aa4 \u0a95\u0abe\u0ab3\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0abe\u0aa6\u0ab3\u0ac0 \u0ab6\u0abe\u0ab9\u0ac0\u0ab5\u0abe\u0ab3\u0ac0 \u0aaa\u0ac7\u0aa8\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb","Write all the answers, including MCQs and fill-in-the-blanks, on the piece of paper":"\u0a95\u0abe\u0a97\u0ab3\u0aa8\u0abe \u0a9f\u0ac1\u0a95\u0aa1\u0abe \u0aaa\u0ab0 MCQ \u0a85\u0aa8\u0ac7 \u0a96\u0abe\u0ab2\u0ac0 \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a93 \u0aad\u0ab0\u0ab5\u0abe \u0ab8\u0ab9\u0abf\u0aa4 \u0aac\u0aa7\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0ab2\u0a96\u0acb.","Use the same numbering system as the question paper; take extra care to write the numbers clearly":"\u0aaa\u0acd\u0ab0\u0ab6\u0acd\u0aa8\u0aaa\u0aa4\u0acd\u0ab0 \u0a9c\u0ac7\u0ab5\u0ac0 \u0a9c \u0aa8\u0a82\u0aac\u0ab0\u0abf\u0a82\u0a97 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb; \u0ab8\u0a82\u0a96\u0acd\u0aaf\u0abe\u0a93 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab2\u0a96\u0ab5\u0abe\u0aa8\u0ac0 \u0a96\u0abe\u0ab8 \u0a95\u0abe\u0ab3\u0a9c\u0ac0 \u0ab2\u0acb.","Write clearly and make sure the letters do not touch the edges of the page. If a mistake is made, strike it out neatly and write it again":"\u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0ab2\u0a96\u0acb \u0a85\u0aa8\u0ac7 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0a85\u0a95\u0acd\u0ab7\u0ab0\u0acb \u0aaa\u0abe\u0aa8\u0abe\u0aa8\u0ac0 \u0a95\u0abf\u0aa8\u0abe\u0ab0\u0ac0\u0a93\u0aa8\u0ac7 \u0ab8\u0acd\u0aaa\u0ab0\u0acd\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a9c\u0acb \u0a95\u0acb\u0a88 \u0aad\u0ac2\u0ab2 \u0aa5\u0a88 \u0a9c\u0abe\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab8\u0ab0\u0ab8 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0aaa\u0ac0\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0ab2\u0a96\u0acb.","Processing...":"\u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7...","Processing images...":"\u0a9b\u0aac\u0ac0\u0a93 \u0aaa\u0ab0 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7...","We recommend uploading up to 20 images":"\u0a85\u0aae\u0ac7 20 \u0a9b\u0aac\u0ac0\u0a93 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aad\u0ab2\u0abe\u0aae\u0aa3 \u0a95\u0ab0\u0ac0\u0a8f \u0a9b\u0ac0\u0a8f.","Submit for Review":"\u0ab8\u0aae\u0ac0\u0a95\u0acd\u0ab7\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acb",Uploading:"\u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7","Uploading Files":"\u0aab\u0abe\u0a87\u0ab2\u0acb \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac0\u0a8f","Images are successfully uploaded":"\u0a9b\u0aac\u0ac0\u0a93 \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0aa5\u0a88","Failed to upload images. Please try again.":"\u0a9b\u0aac\u0ac0\u0a93 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0aa5\u0aaf\u0abe. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.","No Images":"\u0a95\u0acb\u0a88 \u0a9b\u0aac\u0ac0\u0a93 \u0aa8\u0aa5\u0ac0","Please select images to upload.":"\u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9b\u0aac\u0ac0\u0a93 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb.",Error:"\u0aad\u0ac2\u0ab2","Failed to capture photo. Please try again.":"\u0aab\u0acb\u0a9f\u0acb \u0a95\u0ac7\u0aaa\u0acd\u0a9a\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.","Failed to select images. Please try again.":"\u0a9b\u0aac\u0ac0\u0a93 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0aa5\u0aaf\u0abe\u0a82. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.","Your answers have been successfully submitted for evaluation":"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0abe \u0a9b\u0ac7.","You'll be notified as soon as the evaluation is complete.":"\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0aa4\u0abe\u0a82\u0aa8\u0ac0 \u0ab8\u0abe\u0aa5\u0ac7 \u0a9c \u0aa4\u0aae\u0aa8\u0ac7 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.","In the meantime, make sure you've submitted all required answers correctly. If you face any issues, please reach out to your facilitator.":"\u0a86 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8, \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a95\u0ac7 \u0aa4\u0aae\u0ac7 \u0aac\u0aa7\u0abe \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9c\u0ab5\u0abe\u0aac\u0acb \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab8\u0aac\u0aae\u0abf\u0a9f \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0a9b\u0ac7. \u0a9c\u0acb \u0aa4\u0aae\u0aa8\u0ac7 \u0a95\u0acb\u0a88 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a86\u0ab5\u0ac7, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aab\u0ac7\u0ab8\u0abf\u0ab2\u0abf\u0a9f\u0ac7\u0a9f\u0ab0\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0acb.","Loading assessment data...":"\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aa1\u0ac7\u0a9f\u0abe \u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7...","No assessment data available yet":"\u0ab9\u0a9c\u0ac1 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a95\u0acb\u0a88 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0aa1\u0ac7\u0a9f\u0abe \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0aa8\u0aa5\u0ac0.",Image:"\u0a9b\u0aac\u0ac0","Images Uploaded":"\u0a9b\u0aac\u0ac0\u0a93 \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0","Permission Test Component":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0aaa\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0aa3 \u0a98\u0a9f\u0a95","Check Permissions":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93 \u0aa4\u0aaa\u0abe\u0ab8\u0acb","Request Permissions":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0acb","Permission Status":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf","Permission Request Result":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae",Granted:"\u0aae\u0a82\u0a9c\u0ac2\u0ab0",Denied:"\u0aa8\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0ac1\u0a82","Failed to check permissions":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93 \u0aa4\u0aaa\u0abe\u0ab8\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0aa5\u0aaf\u0abe\u0a82","Failed to request permissions":"\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0\u0a93\u0aa8\u0ac0 \u0ab5\u0abf\u0aa8\u0a82\u0aa4\u0ac0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0aa5\u0aaf\u0abe\u0a82",OK:"\u0aac\u0ab0\u0abe\u0aac\u0ab0",confirm:"\u0aaa\u0ac1\u0ab7\u0acd\u0a9f\u0abf \u0a95\u0ab0\u0acb",delete_item:"\u0ab5\u0ab8\u0acd\u0aa4\u0ac1 \u0a95\u0abe\u0aa2\u0ac0 \u0aa8\u0abe\u0a96\u0acb",are_you_sure_you_want_to_delete_this_item:"\u0ab6\u0ac1\u0a82 \u0aa4\u0aae\u0ac7 \u0a96\u0ab0\u0ac7\u0a96\u0ab0 \u0a86 \u0a86\u0a87\u0a9f\u0aae \u0a95\u0abe\u0aa2\u0ac0 \u0aa8\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb?",success:"\u0ab8\u0aab\u0ab3\u0aa4\u0abe",error:"\u0aad\u0ac2\u0ab2",warning:"\u0a9a\u0ac7\u0aa4\u0ab5\u0aa3\u0ac0","###DOWNLOAD###":"###\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb###",download:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb",downloading:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7",download_complete:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3",download_failed:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0aa5\u0aaf\u0ac1\u0a82",download_starting:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7... \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab0\u0abe\u0ab9 \u0a9c\u0ac1\u0a93.",download_success_message:"\u0a9b\u0aac\u0ac0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1\u0acd\u0ab8/\u0ab2\u0ab0\u0acd\u0aa8\u0ab0\u0a8f\u0aaa\u0aae\u0abe\u0a82 \u0ab8\u0abe\u0a9a\u0ab5\u0ac0",download_failed_message:"\u0a9b\u0aac\u0ac0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a87\u0aa8\u0acd\u0a9f\u0ab0\u0aa8\u0ac7\u0a9f \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0aa4\u0aaa\u0abe\u0ab8\u0acb \u0a85\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb.",no_image_url:"\u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acb\u0a88 \u0a9b\u0aac\u0ac0 URL \u0a89\u0aaa\